{
  "name": "@financia/hearing",
  "version": "0.1.0",
  "private": true,
  "description": "ファイナンシアのヒアリングシート（シート定義・Excel の書き出しと取り込み・世帯データとの変換。0018）",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "test": "vitest run",
    "layout": "node --disable-warning=ExperimentalWarning scripts/layout.ts",
    "layout:check": "node --disable-warning=ExperimentalWarning scripts/layout.ts --check",
    "registry": "node --disable-warning=ExperimentalWarning scripts/registry.ts",
    "registry:check": "node --disable-warning=ExperimentalWarning scripts/registry.ts --check",
    "sample": "node --disable-warning=ExperimentalWarning scripts/sample.ts",
    "sample:check": "node --disable-warning=ExperimentalWarning scripts/sample.ts --check",
    "check:licenses": "node --disable-warning=ExperimentalWarning scripts/check-licenses.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "ajv": "8.20.0",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
