{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "0016 の1: 画面から呼べるのは、アプリが定義した命令だけ（プラグインの権限は与えない。ファイル・ダイアログも画面には与えず、保存・開くは用途ごとの命令の中で本体が行う）。命令を足すときは、このファイルの差分をレビューする",
  "windows": ["main"],
  "permissions": [
    "allow-engine-packs",
    "allow-list-households",
    "allow-open-household",
    "allow-compute",
    "allow-evidence",
    "allow-proposal-render",
    "allow-proposal-page",
    "allow-proposal-save",
    "allow-proposal-discard",
    "allow-hearing-save",
    "allow-hearing-open"
  ]
}
