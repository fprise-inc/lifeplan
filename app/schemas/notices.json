{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "notices.json",
  "title": "配信元のお知らせ（0087）",
  "description": "全員に同じ一覧を配る。封筒（envelope）の payload に一覧（feed）の JSON を文字列のまま入れ、その UTF-8 のバイト列にデータ用の鍵（0017 の5）で切り離した Ed25519 の署名を付ける。アプリは何も送り返さない。宣伝の種類は無い",
  "$ref": "#/$defs/envelope",
  "$defs": {
    "envelope": {
      "type": "object",
      "required": [
        "format",
        "formatVersion",
        "payload",
        "signatures"
      ],
      "properties": {
        "format": {
          "const": "financia-notices-envelope"
        },
        "formatVersion": {
          "type": "string",
          "pattern": "^1\\.\\d+$"
        },
        "comment": {
          "type": "string"
        },
        "payload": {
          "type": "string",
          "description": "feed の JSON の文字列（署名はこの文字列のバイト列に対して）"
        },
        "signatures": {
          "type": "array",
          "description": "どれか1つが、アプリに埋め込んだデータ用の鍵（現用・次期）で確かめられれば受け付ける。空は開発用のビルドだけが受け付ける",
          "items": {
            "type": "object",
            "required": [
              "keyId",
              "alg",
              "sig"
            ],
            "properties": {
              "keyId": {
                "type": "string"
              },
              "alg": {
                "const": "ed25519"
              },
              "sig": {
                "type": "string",
                "description": "base64"
              }
            }
          }
        }
      }
    },
    "feed": {
      "type": "object",
      "required": [
        "format",
        "formatVersion",
        "issuedAt",
        "notices"
      ],
      "properties": {
        "format": {
          "const": "financia-notices"
        },
        "formatVersion": {
          "type": "string",
          "pattern": "^1\\.\\d+$",
          "description": "MAJOR.MINOR（0001）。MINOR を上げた一覧は、古いアプリが知らない欄を無視して読む"
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "notices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/notice"
          }
        }
      }
    },
    "notice": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "urgency",
        "date",
        "title",
        "body"
      ],
      "description": "知らない kind・urgency・screen の1件、形の合わない1件は、アプリが捨てる（ほかの件は読む）",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "一覧の中で重ならない。既読の印の鍵になる（変えない）"
        },
        "kind": {
          "enum": [
            "app",
            "data"
          ],
          "description": "app＝ファイナンシアから（更新の中身・新しい機能・要望への対応）、data＝制度・データの更新（制度データ・学費などの更新・誤りの修正）"
        },
        "urgency": {
          "enum": [
            "critical",
            "normal",
            "info"
          ],
          "description": "critical＝重大（上の帯の札でも出す）、normal＝ふつう（件数に数える）、info＝参考（一覧に入るだけ）"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "何があったか"
        },
        "body": {
          "type": "string",
          "description": "何が変わったか"
        },
        "appVersions": {
          "type": "object",
          "description": "対象の版の範囲（どちらも含む）。無ければ全部の版",
          "properties": {
            "min": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            },
            "max": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            }
          }
        },
        "receipts": {
          "type": "array",
          "minItems": 1,
          "description": "受付番号の並び。あれば、手元に覚えた番号と合う PC にだけ「あなたの要望に対応しました」として出す（合わない PC には一覧にも出さない）",
          "items": {
            "type": "string",
            "pattern": "^R-[23456789ABCDEFGHJKMNPQRSTUVWXYZ]{4}$"
          }
        },
        "screen": {
          "enum": [
            "plans",
            "work",
            "family",
            "storage",
            "office",
            "households",
            "recovery"
          ],
          "description": "関係する画面（詳しい中身にその画面を開くボタンを出す）"
        }
      }
    }
  }
}
