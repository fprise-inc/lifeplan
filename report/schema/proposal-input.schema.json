{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lifeplan:schema:proposalInput:0.1.0",
  "title": "帳票の入力（提案書。試験版 0.1.0）",
  "description": "0009 の9: 公式の帳票（@lifeplan/report-core）に渡す、提示に必要な値だけの JSON。宛名・氏名・FP のメモ・カスタム計算の印・世帯の内部 ID は入れない。金額は円の整数で、計算エンジンの出力を写すか足したもの",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "document", "basis", "members", "assumptions", "summary", "basics", "events", "cashflow", "assets", "balanceSheet", "education", "housingLoan", "retirement", "contingency", "insurance", "changes"],
  "properties": {
    "format": { "const": "lifeplan.proposalInput" },
    "version": { "const": "0.1.0" },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "issuedOn", "preparedBy"],
      "properties": {
        "title": { "type": "string" },
        "issuedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "preparedBy": { "type": ["string", "null"] }
      }
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseMonth", "baseMonthLabel", "years"],
      "properties": {
        "baseMonth": { "$ref": "#/$defs/month" },
        "baseMonthLabel": { "type": "string" },
        "years": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/year" } }
      }
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "ageAtBase", "ages"],
        "properties": {
          "key": { "$ref": "#/$defs/presentKey" },
          "label": { "type": "string" },
          "ageAtBase": { "type": "integer" },
          "ages": { "type": "array", "items": { "type": ["integer", "null"] } }
        }
      }
    },
    "assumptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rates", "dataSet", "survivor", "survivorReform", "advisoryFee", "notes"],
      "properties": {
        "rates": { "type": "array", "items": { "$ref": "#/$defs/labelValue" } },
        "dataSet": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "version", "fictional"],
            "properties": { "label": { "type": "string" }, "version": { "type": "string" }, "fictional": { "type": "boolean" } }
          }
        },
        "survivor": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["beforeIndependence", "afterIndependence", "noChildren", "source"],
              "properties": {
                "beforeIndependence": { "type": "string" },
                "afterIndependence": { "type": "string" },
                "noChildren": { "type": "string" },
                "source": { "enum": ["input", "default"] }
              }
            }
          ]
        },
        "survivorReform": { "type": "boolean" },
        "advisoryFee": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["contracts", "total", "firstYear", "lastYear"],
              "properties": {
                "contracts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["label", "oneTime", "recurring"],
                    "properties": {
                      "label": { "type": "string" },
                      "oneTime": {
                        "type": "array",
                        "items": { "type": "object", "additionalProperties": false, "required": ["month", "amount"], "properties": { "month": { "type": "string" }, "amount": { "$ref": "#/$defs/yen" } } }
                      },
                      "recurring": {
                        "oneOf": [
                          { "type": "null" },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["amount", "per", "from", "to", "revision"],
                            "properties": {
                              "amount": { "$ref": "#/$defs/yen" },
                              "per": { "enum": ["year", "month"] },
                              "from": { "type": "string" },
                              "to": { "type": ["string", "null"] },
                              "revision": { "type": ["string", "null"] }
                            }
                          }
                        ]
                      }
                    }
                  }
                },
                "total": { "$ref": "#/$defs/yen" },
                "firstYear": { "oneOf": [{ "$ref": "#/$defs/year" }, { "type": "null" }] },
                "lastYear": { "oneOf": [{ "$ref": "#/$defs/year" }, { "type": "null" }] }
              }
            }
          ]
        },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "current", "proposal", "diffAtTarget", "depletionShift"],
      "properties": {
        "target": { "$ref": "#/$defs/yearPoint" },
        "current": { "$ref": "#/$defs/outcome" },
        "proposal": { "$ref": "#/$defs/outcome" },
        "diffAtTarget": { "$ref": "#/$defs/yen" },
        "depletionShift": { "type": ["integer", "null"] }
      }
    },
    "basics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["year", "income", "expense", "net", "balanceYear", "balance"],
      "properties": {
        "year": { "$ref": "#/$defs/year" },
        "income": { "$ref": "#/$defs/namedAmounts" },
        "expense": { "$ref": "#/$defs/namedAmounts" },
        "net": { "$ref": "#/$defs/yen" },
        "balanceYear": { "$ref": "#/$defs/year" },
        "balance": { "description": "計算基準年の年末のバランスシート（現状。1列）", "$ref": "#/$defs/balanceSheetView" }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["year", "ages", "items"],
        "properties": { "year": { "$ref": "#/$defs/year" }, "ages": { "type": "string" }, "items": { "type": "array", "items": { "type": "string" } } }
      }
    },
    "cashflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "proposal"],
      "properties": { "current": { "$ref": "#/$defs/cfTable" }, "proposal": { "$ref": "#/$defs/cfTable" } }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "proposal"],
      "properties": { "current": { "$ref": "#/$defs/yens" }, "proposal": { "$ref": "#/$defs/yens" } }
    },
    "balanceSheet": {
      "description": "資産と負債の推移（キャッシュフロー表の章の続き。全資産・全負債）。章を外したときは null",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["figure", "proposal", "currentNetWorth", "netWorth"],
          "properties": {
            "figure": { "description": "バランスシートの図（提案。アプリの「資産と負債」のタブで並べている時点（2〜4つ。既定は今・退職の年・75歳）。共通の縮尺）", "$ref": "#/$defs/balanceFigure" },
            "proposal": { "description": "年の抜粋の提案のバランスシート（図の時点と目標の年。5列に満たなければ10年後も。既定の図なら今・10年後・退職の年・75歳・目標の年）", "$ref": "#/$defs/balanceSheetView" },
            "currentNetWorth": { "description": "同じ時点の現状の純資産", "$ref": "#/$defs/yens" },
            "netWorth": {
              "description": "純資産の推移（basis.years と同じ並び）",
              "type": "object",
              "additionalProperties": false,
              "required": ["current", "proposal"],
              "properties": { "current": { "$ref": "#/$defs/yens" }, "proposal": { "$ref": "#/$defs/yens" } }
            }
          }
        }
      ]
    },
    "education": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["years", "rows", "total", "grandTotal"],
          "properties": {
            "years": { "$ref": "#/$defs/years" },
            "rows": {
              "type": "array",
              "items": { "type": "object", "additionalProperties": false, "required": ["label", "amounts", "total"], "properties": { "label": { "type": "string" }, "amounts": { "$ref": "#/$defs/yens" }, "total": { "$ref": "#/$defs/yen" } } }
            },
            "total": { "$ref": "#/$defs/yens" },
            "grandTotal": { "$ref": "#/$defs/yen" }
          }
        }
      ]
    },
    "housingLoan": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["years", "balance", "repayment", "compare", "effect"],
          "properties": {
            "years": { "$ref": "#/$defs/years" },
            "balance": { "$ref": "#/$defs/yens" },
            "repayment": { "$ref": "#/$defs/yens" },
            "compare": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "payoff", "totalRepayment"],
                "properties": { "label": { "type": "string" }, "payoff": { "$ref": "#/$defs/yearPointOrNull" }, "totalRepayment": { "$ref": "#/$defs/yen" } }
              }
            },
            "effect": { "oneOf": [{ "$ref": "#/$defs/yen" }, { "type": "null" }] }
          }
        }
      ]
    },
    "retirement": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["pensions", "table", "atRetirement", "afterRetirement", "deferral"],
          "properties": {
            "pensions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "start", "annual", "total"],
                "properties": { "label": { "type": "string" }, "start": { "$ref": "#/$defs/yearPointOrNull" }, "annual": { "$ref": "#/$defs/yenOrNull" }, "total": { "$ref": "#/$defs/yen" } }
              }
            },
            "table": { "$ref": "#/$defs/yearTable" },
            "atRetirement": {
              "type": "array",
              "items": { "type": "object", "additionalProperties": false, "required": ["label", "current", "proposal"], "properties": { "label": { "type": "string" }, "current": { "$ref": "#/$defs/yen" }, "proposal": { "$ref": "#/$defs/yen" } } }
            },
            "afterRetirement": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["from", "income", "spending", "gap"],
                  "properties": { "from": { "$ref": "#/$defs/year" }, "income": { "$ref": "#/$defs/yen" }, "spending": { "$ref": "#/$defs/yen" }, "gap": { "$ref": "#/$defs/yen" } }
                }
              ]
            },
            "deferral": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["label", "options"],
                  "properties": {
                    "label": { "type": "string" },
                    "options": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["label", "annual", "totalToTarget", "financialAtTarget"],
                        "properties": { "label": { "type": "string" }, "annual": { "$ref": "#/$defs/yenOrNull" }, "totalToTarget": { "$ref": "#/$defs/yen" }, "financialAtTarget": { "$ref": "#/$defs/yen" } }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "contingency": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["scenarios", "protection"],
          "properties": {
            "scenarios": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "withEvent", "withoutEvent", "depletion", "survivorPension", "survivorPensionTotal", "breakdown", "notices"],
                "properties": {
                  "title": { "type": "string" },
                  "withEvent": { "$ref": "#/$defs/yens" },
                  "withoutEvent": { "$ref": "#/$defs/yens" },
                  "depletion": { "$ref": "#/$defs/yearPointOrNull" },
                  "survivorPension": {
                    "type": "array",
                    "items": { "type": "object", "additionalProperties": false, "required": ["year", "amount"], "properties": { "year": { "$ref": "#/$defs/year" }, "amount": { "$ref": "#/$defs/yen" } } }
                  },
                  "survivorPensionTotal": { "$ref": "#/$defs/yen" },
                  "breakdown": { "$ref": "#/$defs/namedAmounts" },
                  "notices": { "type": "array", "items": { "type": "string" } }
                }
              }
            },
            "protection": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "sub", "years", "need", "needWithAssets", "coverage", "maxShort"],
                "properties": {
                  "title": { "type": "string" },
                  "sub": { "type": "string" },
                  "years": { "$ref": "#/$defs/years" },
                  "need": { "$ref": "#/$defs/yens" },
                  "needWithAssets": { "$ref": "#/$defs/yens" },
                  "coverage": { "$ref": "#/$defs/yens" },
                  "maxShort": {
                    "oneOf": [
                      { "type": "null" },
                      { "type": "object", "additionalProperties": false, "required": ["year", "amount"], "properties": { "year": { "$ref": "#/$defs/year" }, "amount": { "$ref": "#/$defs/yen" } } }
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "insurance": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["contracts", "table", "total"],
          "properties": {
            "contracts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "insured", "premium", "benefits", "status"],
                "properties": {
                  "label": { "type": "string" },
                  "insured": { "type": "string" },
                  "premium": { "type": "string" },
                  "benefits": { "type": "array", "items": { "type": "string" } },
                  "status": { "enum": ["継続", "新規", "解約"] }
                }
              }
            },
            "table": { "$ref": "#/$defs/yearTable" },
            "total": { "type": "object", "additionalProperties": false, "required": ["current", "proposal"], "properties": { "current": { "$ref": "#/$defs/yen" }, "proposal": { "$ref": "#/$defs/yen" } } }
          }
        }
      ]
    },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics", "items", "fee", "steps", "excludingInvestment"],
      "properties": {
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "unit", "current", "proposal", "diff"],
            "properties": {
              "label": { "type": "string" },
              "unit": { "enum": ["yen", "year"] },
              "current": { "type": ["integer", "null"] },
              "proposal": { "type": ["integer", "null"] },
              "diff": { "type": ["integer", "null"] }
            }
          }
        },
        "items": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": false, "required": ["label", "current", "proposal"], "properties": { "label": { "type": "string" }, "current": { "type": "string" }, "proposal": { "type": "string" } } }
        },
        "fee": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["total", "totalToTarget", "diffAtTarget", "diffWithoutFee"],
              "properties": { "total": { "$ref": "#/$defs/yen" }, "totalToTarget": { "$ref": "#/$defs/yen" }, "diffAtTarget": { "$ref": "#/$defs/yen" }, "diffWithoutFee": { "$ref": "#/$defs/yenOrNull" } }
            }
          ]
        },
        "steps": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "investment", "effect", "cumulative"],
                "properties": { "label": { "type": "string" }, "investment": { "type": "boolean" }, "effect": { "$ref": "#/$defs/yen" }, "cumulative": { "$ref": "#/$defs/yen" } }
              }
            }
          ]
        },
        "excludingInvestment": { "$ref": "#/$defs/yenOrNull" }
      }
    },
    "layout": {
      "description": "帳票の組み方（表示の設定。金額ではない）。orientation: 紙の向き（portrait＝縦にそろえる・landscape＝横にそろえる・mixed＝年ごとの表だけ横にする以前の形）、cashflow: キャッシュフロー表の載せ方（summary＝主要な行・全年、excerpt＝全部の行・最初と最後の年と5年ごとと主なできごとの年、full＝全部の行・全年）。省略は portrait・summary",
      "type": "object",
      "additionalProperties": false,
      "required": ["orientation", "cashflow"],
      "properties": {
        "orientation": { "enum": ["portrait", "landscape", "mixed"] },
        "cashflow": { "enum": ["summary", "excerpt", "full"] }
      }
    },
    "chapters": {
      "description": "載せる章（帳票の並び）。省略はすべての章。cover・assumptions は必ず入れる（宛名欄と必須の記載の欄。0009 の3・6）",
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["cover", "assumptions", "summary", "basics", "events", "cashflow", "education", "housing", "retirement", "investment", "marketDrop", "contingency", "insurance", "changes", "comparison"] },
      "allOf": [{ "contains": { "const": "cover" } }, { "contains": { "const": "assumptions" } }]
    },
    "investment": {
      "description": "資産運用の計画（0026）: 入れ方・取り崩しの条件・何歳まで持つか・運用の期間・口座ごとの推移（提案）・資産の内訳（現状と提案を同じ年で）。省略・null は載せない",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["method", "condition", "lasts", "periods", "accounts", "donut"],
      "properties": {
        "method": { "type": "string" },
        "condition": { "type": "string" },
        "lasts": { "type": "object", "additionalProperties": false, "required": ["current", "proposal"], "properties": { "current": { "type": "string" }, "proposal": { "type": "string" } } },
        "periods": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accumText", "holdText", "holdSub", "wdText", "wdSub", "accumEnd", "wdStart", "steps", "estimated"],
          "properties": {
            "accumText": { "type": "string" },
            "holdText": { "type": "string" },
            "holdSub": { "type": "string" },
            "wdText": { "type": "string" },
            "wdSub": { "type": "string" },
            "accumEnd": { "type": ["integer", "null"] },
            "wdStart": { "type": ["integer", "null"] },
            "steps": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["year", "label"], "properties": { "year": { "$ref": "#/$defs/year" }, "label": { "type": "string" } } } },
            "estimated": { "type": "boolean" }
          }
        },
        "accounts": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["label", "color", "values"], "properties": { "label": { "type": "string" }, "color": { "type": "string", "pattern": "^#[0-9a-f]{6}$" }, "values": { "$ref": "#/$defs/yens" } } } },
        "donut": {
          "type": "object",
          "additionalProperties": false,
          "required": ["year", "label", "current", "proposal"],
          "properties": {
            "year": { "$ref": "#/$defs/year" },
            "label": { "type": "string" },
            "current": { "$ref": "#/$defs/coloredAmounts" },
            "proposal": { "$ref": "#/$defs/coloredAmounts" }
          }
        }
      }
    },
    "marketDrop": {
      "description": "相場が下がった場合（0026）: 提案の金融資産と、3つの型（退職の直後の下落・一定期間の低い利回り・ずっと低い利回り）の金融資産。省略・null は載せない",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["proposal", "lasts", "lines"],
      "properties": {
        "proposal": { "$ref": "#/$defs/yens" },
        "lasts": { "type": "string" },
        "lines": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["label", "lasts", "values"], "properties": { "label": { "type": "string" }, "lasts": { "type": "string" }, "values": { "$ref": "#/$defs/yens" } } } }
      }
    },
    "comparison": {
      "description": "案の比較のページ（主画面の比較の表と同じ数字）。差はいつも「その案−基準」。省略・null は載せない",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["target", "base", "columns", "rows"],
      "properties": {
        "target": { "$ref": "#/$defs/yearPoint" },
        "base": { "type": "integer", "minimum": 0 },
        "columns": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": { "type": "object", "additionalProperties": false, "required": ["letter", "name"], "properties": { "letter": { "type": "string" }, "name": { "type": "string" } } }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "label", "unit", "values", "years", "diffs"],
            "properties": {
              "key": { "enum": ["target", "depletion", "takeHome", "expense", "min", "loan"] },
              "label": { "type": "string" },
              "unit": { "enum": ["yen", "year"] },
              "values": { "type": "array", "items": { "type": ["integer", "null"] } },
              "years": { "type": "array", "items": { "type": ["integer", "null"] } },
              "diffs": { "type": "array", "items": { "type": ["integer", "null"] } }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "yen": { "description": "円（整数）", "type": "integer" },
    "yenOrNull": { "type": ["integer", "null"] },
    "yens": { "type": "array", "items": { "type": "integer" } },
    "year": { "type": "integer", "minimum": 1900, "maximum": 2200 },
    "years": { "type": "array", "items": { "$ref": "#/$defs/year" } },
    "month": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
    "presentKey": { "description": "提示用の鍵（物の ID ではない）", "type": "string", "pattern": "^(self|spouse|child[0-9]+|other[0-9]+)$" },
    "labelValue": { "type": "object", "additionalProperties": false, "required": ["label", "value"], "properties": { "label": { "type": "string" }, "value": { "type": "string" } } },
    "namedAmounts": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["label", "amount"], "properties": { "label": { "type": "string" }, "amount": { "$ref": "#/$defs/yen" } } }
    },
    "sheetLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "kind", "amounts"],
      "properties": { "label": { "type": "string" }, "kind": { "enum": ["item", "sub", "total"] }, "amounts": { "$ref": "#/$defs/yens" } }
    },
    "balanceSheetView": {
      "description": "全資産・全負債のバランスシート（年末の値。列は時点）。資産の合計＝負債の合計＋純資産",
      "type": "object",
      "additionalProperties": false,
      "required": ["points", "assets", "liabilities", "netWorth"],
      "properties": {
        "points": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/yearPoint" } },
        "assets": { "type": "array", "items": { "$ref": "#/$defs/sheetLine" } },
        "liabilities": { "type": "array", "items": { "$ref": "#/$defs/sheetLine" } },
        "netWorth": { "$ref": "#/$defs/yens" }
      }
    },
    "balanceFigureBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "amount"],
      "properties": { "key": { "type": "string" }, "label": { "type": "string" }, "amount": { "$ref": "#/$defs/yen" } }
    },
    "balanceFigure": {
      "description": "バランスシートの図（時点ごとに、資産の4つの分け方と、負債と純資産。資産の合計＝負債の合計＋純資産）。時点は年の順に1〜4つ（ふつうは2〜4つ）",
      "type": "object",
      "additionalProperties": false,
      "required": ["scale", "columns"],
      "properties": {
        "scale": { "$ref": "#/$defs/yen" },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["point", "fact", "assets", "liabilities", "negative", "totalAssets", "totalLiabilities", "netWorth", "financial"],
            "properties": {
              "point": { "$ref": "#/$defs/yearPoint" },
              "fact": { "type": "boolean" },
              "assets": { "type": "array", "items": { "$ref": "#/$defs/balanceFigureBox" } },
              "liabilities": { "type": "array", "items": { "$ref": "#/$defs/balanceFigureBox" } },
              "negative": { "$ref": "#/$defs/yen" },
              "totalAssets": { "$ref": "#/$defs/yen" },
              "totalLiabilities": { "$ref": "#/$defs/yen" },
              "netWorth": { "$ref": "#/$defs/yen" },
              "financial": { "$ref": "#/$defs/yen" }
            }
          }
        }
      }
    },
    "yearPoint": { "type": "object", "additionalProperties": false, "required": ["year", "label"], "properties": { "year": { "$ref": "#/$defs/year" }, "label": { "type": "string" } } },
    "yearPointOrNull": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/yearPoint" }] },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["financialAtTarget", "depletion", "totals"],
      "properties": {
        "financialAtTarget": { "$ref": "#/$defs/yen" },
        "depletion": { "$ref": "#/$defs/yearPointOrNull" },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["income", "taxSi", "expense", "net"],
          "properties": { "income": { "$ref": "#/$defs/yen" }, "taxSi": { "$ref": "#/$defs/yen" }, "expense": { "$ref": "#/$defs/yen" }, "net": { "$ref": "#/$defs/yen" } }
        }
      }
    },
    "cfTable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "rows"],
      "properties": {
        "title": { "type": "string" },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "key", "label", "cells"],
            "properties": {
              "kind": { "enum": ["group", "value", "total"] },
              "key": { "type": "string" },
              "label": { "type": "string" },
              "cells": { "type": "array", "items": { "type": ["integer", "null"] } }
            }
          }
        }
      }
    },
    "coloredAmounts": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["label", "amount", "color"], "properties": { "label": { "type": "string" }, "amount": { "$ref": "#/$defs/yen" }, "color": { "type": "string", "pattern": "^#[0-9a-f]{6}$" } } } },
    "yearTable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "rows"],
      "properties": {
        "columns": { "type": "array", "items": { "type": "string" } },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["year", "ages", "cells"],
            "properties": { "year": { "$ref": "#/$defs/year" }, "ages": { "type": "string" }, "cells": { "type": "array", "items": { "type": ["integer", "null"] } } }
          }
        }
      }
    }
  }
}
