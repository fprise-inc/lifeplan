    "rentalMetrics": {"description": "指標（率は書式を当てた文字列。分母が0・無いときは「—」）。月の手残りは年の手残り÷貸している月数", "type": ["object", "null"], "additionalProperties": false, "required": ["year", "grossYield", "netYield", "breakEven", "repaymentRatio", "dscr", "ltv", "ccr", "monthlyBeforeTax", "monthlyAfterTax", "equity", "age", "remainingLife", "lodging"], "properties": {"year": {"$ref": "#/$defs/year"}, "grossYield": {"type": "string"}, "netYield": {"type": "string"}, "breakEven": {"type": "string"}, "repaymentRatio": {"type": "string"}, "dscr": {"type": "string"}, "ltv": {"type": "string"}, "ccr": {"type": "string"}, "monthlyBeforeTax": {"$ref": "#/$defs/yen"}, "monthlyAfterTax": {"$ref": "#/$defs/yen"}, "equity": {"description": "売ったときの手残りの目安（評価額−ローン残高。売却の費用・税は引かない）", "$ref": "#/$defs/yenOrNull"}, "unrealizedGain": {"description": "含み益（評価額−帳簿価額〔取得価額＋取得時の諸費用−減価償却の累計〕。取得価額が無ければ null）。省略は前の版の入力", "$ref": "#/$defs/yenOrNull"}, "age": {"type": ["integer", "null"]}, "remainingLife": {"type": ["integer", "null"]}, "lodging": {"type": ["object", "null"], "additionalProperties": false, "required": ["occupancy", "nightly", "days", "sales"], "properties": {"occupancy": {"type": "string"}, "nightly": {"$ref": "#/$defs/yen"}, "days": {"type": "integer"}, "sales": {"$ref": "#/$defs/yen"}}}}},
    "realEstateProperties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "owner", "use", "structure", "builtYear", "acquisition", "years", "totals", "sale"],
        "properties": {
          "key": { "description": "提示用の鍵（その案の世帯の不動産の並び順。物の ID ではない）", "type": "string", "pattern": "^property[0-9]+$" },
          "label": { "description": "呼び方（不動産1 …。世帯の並び順）", "type": "string" },
          "name": {"description": "物件名（入れていれば。0082 から。所在地・メモは入らない）", "type": ["string", "null"]},
          "kind": {"description": "種類（入れていれば。0082 から）", "oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["key", "label"], "properties": {"key": {"type": "string"}, "label": {"type": "string"}}}]},
          "owner": {
            "description": "名義の人（members の key と label）",
