string", "null"]}, "deadCross": {"type": ["integer", "null"]}, "deadCrossNow": {"description": "計算の最初の年（計算基準年）から、元金の返済が減価償却費をもう上回っている。省略は前の版の入力", "type": "boolean"}, "lodging": {"type": "boolean"}, "actualRent": {"description": "今の実際の家賃収入で入れた物件（表面利回りは今の収入から、損益分岐の入居率は出さない。0126）。省略は満室時の家賃で入れた物件か前の版の入力", "type": "boolean"}, "depreciationFrom": {"description": "減価償却を確定申告の数字から引き継いだ年（0126）。省略は取得価額からの計算か前の版の入力", "$ref": "#/$defs/year"}, "point": {"$ref": "#/$defs/rentalMetrics"}, "years": {"type": "array", "items": {"$ref": "#/$defs/rentalYear"}}, "exit": {"description": "今の予定の売却（税引後の手取り net）", "type": ["object", "null"], "additionalProperties": false, "required": ["month", "price", "costs", "proceeds", "loanPayoff", "tax", "net"], "properties": {"month": {"$ref": "#/$defs/month"}, "price": {"$ref": "#/$defs/yen"}, "costs": {"$ref": "#/$defs/yen"}, "proceeds": {"$ref": "#/$defs/yen"}, "loanPayoff": {"$ref": "#/$defs/yen"}, "tax": {"$ref": "#/$defs/yen"}, "net": {"$ref": "#/$defs/yen"}}}, "saleCompare": {"description": "売る年を変えた比較（表の最後の年の金融資産と、今の予定との差）", "type": ["object", "null"], "additionalProperties": false, "required": ["endYear", "rows"], "properties": {"endYear": {"$ref": "#/$defs/year"}, "rows": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["label", "current", "net", "financialEnd", "diff", "equityEnd"], "properties": {"label": {"type": "string"}, "current": {"type": "boolean"}, "net": {"$ref": "#/$defs/yenOrNull"}, "financialEnd": {"$ref": "#/$defs/yen"}, "diff": {"$ref": "#/$defs/yen"}, "equityEnd": {"$ref": "#/$defs/yenOrNull"}}}}}}}}}, "total": {"description": "全物件の合計（物件が2件以上のときだけ）", "type": ["object", "null"], "additionalProperties": false, "required": ["point", "years"], "properties": {"point": {"$ref": "#/$defs/rentalMetrics"}, "years": {"type": "array", "items": {"$ref": "#/$defs/rentalYear"}}}}}},
    "moneyThree": {
      "description": "お金の3つの分け方（説明用の図。0032）: 提案のプランの今の時点の金融資産を、使うお金（ふだんの支出の○か月分）・貯めるお金（今後○年のできごとの支出のうち、その年の収入で賄えない分）・増やすお金（残り）に分け、今の置き場所と並べる。アプリの区画と同じ値・同じ言葉（report/src/moneyThree.ts）。キャッシュフロー表・結果の計算には混ぜない。省略・null は載せない",
