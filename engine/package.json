{
  "name": "@financia/engine",
  "version": "0.1.0",
  "private": true,
  "description": "ファイナンシアの計算エンジン（TypeScript）",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "gen": "node --disable-warning=ExperimentalWarning scripts/gen.ts && node --disable-warning=ExperimentalWarning scripts/registry.ts",
    "build": "npm run gen && node --disable-warning=ExperimentalWarning scripts/build.ts && node --disable-warning=ExperimentalWarning scripts/build-regulation.ts",
    "typecheck": "npm run gen && tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "lint": "npm run gen && eslint .",
    "test": "npm run gen && vitest run",
    "parity": "node --disable-warning=ExperimentalWarning scripts/parity.ts",
    "check:licenses": "node --disable-warning=ExperimentalWarning scripts/check-licenses.ts",
    "l2": "node --disable-warning=ExperimentalWarning scripts/l2-report.ts",
    "models": "node --disable-warning=ExperimentalWarning scripts/model-households.ts",
    "bench": "node --disable-warning=ExperimentalWarning scripts/bench.ts",
    "registry:check": "node --disable-warning=ExperimentalWarning scripts/gen.ts && node --disable-warning=ExperimentalWarning scripts/registry.ts --check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "ajv": "8.20.0",
    "decimal.js": "10.6.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
