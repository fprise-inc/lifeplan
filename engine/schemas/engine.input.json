          "propertyNames": { "enum": ["medical", "elderlySupport", "care", "childSupport"] },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "incomeRate": { "title": "所得割の率", "$ref": "urn:financia:schema:common#/$defs/boxRate" },
              "perCapita": { "title": "均等割（年額）", "$ref": "urn:financia:schema:common#/$defs/boxYen" },
              "perHousehold": { "title": "平等割（年額）", "$ref": "urn:financia:schema:common#/$defs/boxYen" }
            }
          }
        },
        "baseMonthly": { "title": "介護保険（第1号）の基準額（月額）", "x-item": "premiumRate.baseMonthly", "$ref": "urn:financia:schema:common#/$defs/boxYen" }
      }
    },
    "residentTaxAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "member", "fiscalYear", "amount"],
      "properties": {
        "id": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
        "member": { "title": "納税する構成員", "x-item": "residentTaxAssessment.member", "$ref": "urn:financia:schema:common#/$defs/uuid" },
        "fiscalYear": { "title": "年度", "x-item": "residentTaxAssessment.fiscalYear", "$ref": "urn:financia:schema:common#/$defs/year" },
        "amount": { "title": "住民税の年税額（森林環境税を含む）", "x-item": "residentTaxAssessment.amount", "$ref": "urn:financia:schema:common#/$defs/boxYen" },
        "collection": { "title": "徴収の方法（省略は働き方から決める）", "x-item": "residentTaxAssessment.collection", "enum": ["special", "ordinary"] }
      }
    }
  }
