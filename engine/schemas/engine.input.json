{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:financia:schema:engine.input",
  "title": "エンジン全体の入力（世帯のデータモデル 0008 のうち、税・社会保険料の部品が使う最小の部分）",
  "description": "0004 の7・0006 の5: 知らない欄（参照値を含む）は拒む。x-item は入力項目ID（0004）、x-collection は物の集まりの名前、x-owner はその物がどの構成員の物かを表す欄（0006 の追記: 構成員ごとの依存）。登録簿 registry/items.yaml はここから作る",
  "type": "object",
  "additionalProperties": false,
  "required": ["baseMonth", "endYear", "calcConventions", "household", "assumptions"],
  "properties": {
    "baseMonth": { "$ref": "urn:financia:schema:common#/$defs/yearMonth" },
    "endYear": { "$ref": "urn:financia:schema:common#/$defs/year" },
    "calcConventions": {
      "description": "0003 の7: 計算方式の設定",
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregation", "investmentTiming", "compatibility"],
      "properties": {
        "aggregation": { "enum": ["cash", "accrual"] },
        "investmentTiming": { "enum": ["midYear", "beginning", "end"] },
        "compatibility": { "type": "null" }
      }
    },
    "dataSet": {
      "description": "0007 の8: 使うパックの版（知った時点）。省略したパックは渡された最新の版",
      "type": "object",
      "propertyNames": { "pattern": "^(regulation|master)(\\.[a-z][a-zA-Z0-9]*)+$" },
      "additionalProperties": { "$ref": "urn:financia:schema:regulation.value#/$defs/packVersion" }
    },
    "household": { "$ref": "#/$defs/household" },
    "assumptions": {
      "description": "0006 の6・0008 の8: 前提条件は年ごとの列",
      "type": "object",
      "additionalProperties": false,
      "required": ["investmentReturn"],
      "properties": {
        "investmentReturn": { "title": "運用利回り（年率）", "x-item": "assumptions.investmentReturn", "$ref": "urn:financia:schema:common#/$defs/yearSeries" },
        "wageGrowth": { "title": "賃金上昇率（年率。省略は0）", "x-item": "assumptions.wageGrowth", "$ref": "urn:financia:schema:common#/$defs/yearSeries" },
        "inflation": { "title": "物価上昇率（年率。省略は0。年金額の改定に使う）", "x-item": "assumptions.inflation", "$ref": "urn:financia:schema:common#/$defs/yearSeries" },
        "pensionMacroSlide": {
          "title": "年金額のマクロ経済スライドの調整率（年度ごと。正の率で書き、改定率から引く。省略は0）",
          "x-item": "assumptions.pensionMacroSlide",
          "$ref": "urn:financia:schema:common#/$defs/yearSeries"
        },
        "pensionMacroSlideEmployee": {
          "title": "厚生年金（報酬比例）のマクロ経済スライドの調整率（省略は基礎年金と同じ）",
          "x-item": "assumptions.pensionMacroSlideEmployee",
          "$ref": "urn:financia:schema:common#/$defs/yearSeries"
        }
      }
    }
  },
  "$defs": {
    "household": {
      "description": "0008: 世帯（現状の版のうち計算に使う部分）",
      "type": "object",
      "additionalProperties": false,
      "required": ["members", "relations", "events", "employmentPeriods", "accounts", "insuranceContracts"],
      "properties": {
        "members": { "type": "array", "x-collection": "member", "x-owner": ["id"], "items": { "$ref": "#/$defs/member" } },
        "relations": { "type": "array", "x-collection": "relation", "x-owner": ["a", "b", "parent", "child"], "items": { "$ref": "#/$defs/relation" } },
        "events": { "type": "array", "x-collection": "event", "x-owner": ["member"], "items": { "$ref": "#/$defs/event" } },
        "employmentPeriods": { "type": "array", "x-collection": "employment", "x-owner": ["member"], "items": { "$ref": "#/$defs/employmentPeriod" } },
        "accounts": { "type": "array", "x-collection": "account", "x-owner": ["owner"], "items": { "$ref": "#/$defs/account" } },
        "insuranceContracts": { "type": "array", "x-collection": "insurance", "x-owner": ["policyholder", "insured"], "items": { "$ref": "#/$defs/insuranceContract" } },
        "residentTaxAssessments": {
          "description": "置き換え口（0006 の5）: 住民税の決定通知書の年税額。与えられた年度はこの額を使う",
          "type": "array",
          "x-collection": "residentTaxAssessment", "x-owner": ["member"],
          "items": { "$ref": "#/$defs/residentTaxAssessment" }
        },
        "pensionRecords": {
          "description": "公的年金の加入の記録（構成員ごとに1件まで）。ねんきん定期便・年金額の通知・加入歴・見込額のどれかの型で入れる",
          "type": "array",
          "x-collection": "pensionRecord", "x-owner": ["member"],
          "items": { "$ref": "#/$defs/pensionRecord" }
        },
        "premiumAssessments": {
          "description": "置き換え口（0006 の5）: 国民健康保険（世帯主に世帯の合計）・後期高齢者医療・介護保険（第1号）の決定通知書の年額。与えられた年度はこの額を使う",
          "type": "array",
          "x-collection": "premiumAssessment", "x-owner": ["member"],
          "items": { "$ref": "#/$defs/premiumAssessment" }
        },
        "premiumRates": {
          "description": "上書き（0008 の7 の範囲②）: 住んでいる市町村・広域連合の国民健康保険・後期高齢者医療・介護保険（第1号）の料率。省略は全国の標準的な値",
          "type": "array",
          "x-collection": "premiumRate",
          "items": { "$ref": "#/$defs/premiumRate" }
        }
      }
    },
    "timepointOrNull": { "oneOf": [{ "type": "null" }, { "$ref": "urn:financia:schema:common#/$defs/timepoint" }] },
    "member": {
      "description": "0008 の3: 構成員",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "birth", "sex", "joins", "leaves", "expected"],
      "properties": {
        "id": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
        "kind": { "title": "家族の種類", "x-item": "member.kind", "enum": ["self", "spouse", "child", "parent", "grandparent", "other"] },
        "birth": { "title": "生年月と1日生まれか", "x-item": "member.birth", "$ref": "urn:financia:schema:common#/$defs/birth" },
        "sex": { "title": "性別", "x-item": "member.sex", "enum": ["female", "male"] },
        "joins": { "title": "世帯に加わる時点（null は最初から）", "x-item": "member.joins", "$ref": "#/$defs/timepointOrNull" },
        "leaves": { "title": "世帯から離れる時点（null は最後まで）", "x-item": "member.leaves", "$ref": "#/$defs/timepointOrNull" },
        "expected": { "title": "まだいない家族か（出産予定・結婚予定）", "x-item": "member.expected", "type": "boolean" },
        "support": {
          "title": "親・祖父母の扶養と同居",
          "x-item": "member.support",
          "type": "object",
          "additionalProperties": false,
          "required": ["dependent", "cohabiting"],
          "properties": {
            "dependent": { "type": "boolean" },
            "cohabiting": { "type": "boolean" },
            "allowance": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" }
          }
        }
      }
    },
    "relation": {
      "description": "0008 の3: 関係（辺の一覧）",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "a", "b", "marriage", "from", "to"],
          "properties": {
            "type": { "title": "関係の種類", "x-item": "relation.type", "const": "spouse" },
            "a": { "title": "配偶者の一方", "x-item": "relation.a", "$ref": "urn:financia:schema:common#/$defs/uuid" },
            "b": { "title": "配偶者の他方", "x-item": "relation.b", "$ref": "urn:financia:schema:common#/$defs/uuid" },
            "marriage": { "title": "法律婚か事実婚か", "x-item": "relation.marriage", "enum": ["legal", "deFacto"] },
            "from": { "title": "関係の始まり（null は最初から）", "x-item": "relation.from", "$ref": "#/$defs/timepointOrNull" },
            "to": { "title": "関係の終わり（null は最後まで）", "x-item": "relation.to", "$ref": "#/$defs/timepointOrNull" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "parent", "child"],
          "properties": {
            "type": { "x-item": "relation.type", "const": "parentOf" },
            "parent": { "title": "親", "x-item": "relation.parent", "$ref": "urn:financia:schema:common#/$defs/uuid" },
            "child": { "title": "子", "x-item": "relation.child", "$ref": "urn:financia:schema:common#/$defs/uuid" }
          }
        }
      ]
    },
    "event": {
      "description": "0003 の6: 名前つきイベント",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "at"],
      "properties": {
        "id": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
        "kind": { "title": "イベントの種類", "x-item": "event.kind", "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
        "member": { "title": "イベントの構成員", "x-item": "event.member", "$ref": "urn:financia:schema:common#/$defs/uuid" },
        "at": { "title": "イベントの時点", "x-item": "event.at", "$ref": "urn:financia:schema:common#/$defs/timepoint" }
      }
    },
    "employmentPeriod": {
      "description": "0008 の4: 人ごとの働き方の期間。期間は重ならない。休業は期間を分けて表し、直前の勤め先の期間の保険を引き継ぐ。被保険者の種別（第1〜3号）・被用者保険と雇用保険に入るかは、ここからエンジンが月ごとに導く（上書きは employeeInsurance・employmentInsuranceCovered）",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "member", "from", "to", "type"],
      "properties": {
        "id": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
        "member": { "title": "働く構成員", "x-item": "employment.member", "$ref": "urn:financia:schema:common#/$defs/uuid" },
        "from": { "title": "期間の始まり（その月を含む）", "x-item": "employment.from", "$ref": "urn:financia:schema:common#/$defs/timepoint" },
        "to": { "title": "期間の終わり（その月を含む。null は最後まで）", "x-item": "employment.to", "$ref": "#/$defs/timepointOrNull" },
        "type": { "title": "働き方", "x-item": "employment.type", "enum": ["regular", "contract", "partTime", "selfEmployed", "civilServant", "leave", "unemployed"] },
        "leaveKind": { "title": "休業の種類", "x-item": "employment.leaveKind", "enum": ["maternity", "childcare", "sick", "other"] },
        "leaveChild": { "title": "産前産後休業・育児休業の対象の子（省略は休業の始まりに近い子から決める）", "x-item": "employment.leaveChild", "$ref": "urn:financia:schema:common#/$defs/uuid" },
        "healthInsurance": {
          "description": "会社員などの期間は勤め先の健康保険（協会けんぽ・健保組合・共済）。自営・無職の期間に書いたときは、エンジンが導く健康保険の種類の上書き（国民健康保険・家族の扶養・任意継続）",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "title": "健康保険の種類",
              "x-item": "employment.healthInsurance.kind",
              "enum": ["kyokaikenpo", "union", "mutualAid", "national", "dependent", "continuation", "lateElderly"]
            },
            "insurer": {
              "title": "保険者（協会けんぽの支部 kyokaikenpo.01〜47）",
              "x-item": "employment.healthInsurance.insurer",
              "type": "string",
              "pattern": "^kyokaikenpo\\.(0[1-9]|[1-3][0-9]|4[0-7])$"
            },
            "employeeRate": { "title": "健康保険料率の被保険者負担分（健保組合・共済）", "x-item": "employment.healthInsurance.employeeRate", "$ref": "urn:financia:schema:common#/$defs/boxRate" },
            "careEmployeeRate": { "title": "介護保険料率の被保険者負担分（健保組合・共済）", "x-item": "employment.healthInsurance.careEmployeeRate", "$ref": "urn:financia:schema:common#/$defs/boxRate" },
            "childSupportEmployeeRate": {
              "title": "子ども・子育て支援金率の被保険者負担分（健保組合・共済。省略は全国一律の率の半分）",
              "x-item": "employment.healthInsurance.childSupportEmployeeRate",
              "$ref": "urn:financia:schema:common#/$defs/boxRate"
            }
          },
          "allOf": [
            { "if": { "properties": { "kind": { "const": "kyokaikenpo" } } }, "then": { "required": ["insurer"] } },
            { "if": { "properties": { "kind": { "enum": ["union", "mutualAid"] } } }, "then": { "required": ["employeeRate"] } }
          ]
        },
        "pensionCategory": { "title": "厚生年金の種別（none は厚生年金に入らない勤め先）", "x-item": "employment.pensionCategory", "enum": ["employee1", "employee2", "employee3", "employee4", "none"] },
        "employer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size", "weeklyHours"],
          "properties": {
            "size": { "title": "勤務先の従業員数（被保険者の数。適用拡大の企業規模の要件）", "x-item": "employment.employer.size", "type": "integer", "minimum": 0 },
            "weeklyHours": { "title": "週の所定労働時間", "x-item": "employment.employer.weeklyHours", "$ref": "urn:financia:schema:common#/$defs/rate" },
            "fullTimeWeeklyHours": { "title": "通常の労働者の週の所定労働時間（4分の3の基準。省略は40）", "x-item": "employment.employer.fullTimeWeeklyHours", "$ref": "urn:financia:schema:common#/$defs/rate" },
            "industry": { "title": "雇用保険の事業の種類（省略は一般）", "x-item": "employment.employer.industry", "enum": ["general", "agricultureEtc", "construction"] }
          }
        },
        "student": { "title": "学生か（短時間労働者の適用拡大・雇用保険の対象から外れる）", "x-item": "employment.student", "type": "boolean" },
        "employeeInsurance": {
          "title": "上書き: 被用者保険（健康保険・厚生年金）に入るか（省略はエンジンが働き方から導く）",
          "x-item": "employment.employeeInsurance",
          "$ref": "urn:financia:schema:common#/$defs/boxBoolean"
        },
        "employmentInsuranceCovered": {
          "title": "上書き: 雇用保険の被保険者か（省略はエンジンが週の所定労働時間などから導く）",
          "x-item": "employment.employmentInsuranceCovered",
          "type": "boolean"
        },
        "salary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["annual", "bonus"],
          "properties": {
            "annual": { "title": "給与（賞与を除く年額。期間の最初の年の額）", "x-item": "employment.salary.annual", "$ref": "urn:financia:schema:common#/$defs/boxYen" },
            "bonus": { "title": "賞与（年間の合計）", "x-item": "employment.salary.bonus", "$ref": "urn:financia:schema:common#/$defs/boxYen" },
            "bonusMonths": {
              "title": "賞与の支給月（省略は6月・12月）",
              "x-item": "employment.salary.bonusMonths",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 1, "maximum": 12 }
            },
            "commutingMonthly": { "title": "非課税の通勤手当（月額）", "x-item": "employment.salary.commutingMonthly", "$ref": "urn:financia:schema:common#/$defs/boxYen" },
            "contractualMonthly": {
              "title": "所定内賃金の月額（適用拡大の賃金の要件。省略は給与の年額の12分の1）",
              "x-item": "employment.salary.contractualMonthly",
              "$ref": "urn:financia:schema:common#/$defs/boxYen"
            },
            "growth": {
              "title": "昇給の仕方（省略は賃金上昇率だけ。curve は昇給カーブのマスタデータの値ID）",
              "x-item": "employment.salary.growth",
              "type": "object",
              "additionalProperties": false,
              "required": ["curve"],
              "properties": { "curve": { "$ref": "urn:financia:schema:common#/$defs/dottedId" } }
            }
          }
        },
        "business": {
          "title": "自営の事業所得（年額。青色申告特別控除の後。期間の最初の年の額）",
          "type": "object",
          "additionalProperties": false,
          "required": ["income"],
          "properties": {
            "income": { "title": "事業所得（年額）", "x-item": "employment.business.income", "$ref": "urn:financia:schema:common#/$defs/boxYen" }
          }
        },
        "childcareShortHours": {
          "title": "育児のための短時間勤務（2歳未満の子。育児時短就業給付）",
          "x-item": "employment.childcareShortHours",
          "type": "object",
          "additionalProperties": false,
          "required": ["child"],
          "properties": {
            "child": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
            "wageBefore": { "title": "時短の前の賃金の月額（省略は直前の期間の給与）", "$ref": "urn:financia:schema:common#/$defs/boxYen" }
          }
        },
        "standardMonthlyRemuneration": {
          "title": "置き換え口: 標準報酬月額（健康保険・厚生年金。給与明細・決定通知の額）",
          "x-item": "employment.standardMonthlyRemuneration",
          "type": "object",
          "additionalProperties": false,
          "required": ["health", "pension"],
          "properties": {
            "health": { "$ref": "urn:financia:schema:common#/$defs/boxYen" },
            "pension": { "$ref": "urn:financia:schema:common#/$defs/boxYen" }
          }
        },
        "endsOnMonthEnd": { "title": "期間の最後の月の末日に辞めるか（省略は真）", "x-item": "employment.endsOnMonthEnd", "type": "boolean" },
        "retirementBenefit": { "title": "退職給付", "x-item": "employment.retirementBenefit", "$ref": "urn:financia:schema:common#/$defs/uuid" },
        "endsWith": { "title": "期間の終わり方", "x-item": "employment.endsWith", "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "leave" } } }, "then": { "required": ["leaveKind"] } },
        {
          "if": { "properties": { "type": { "enum": ["regular", "contract", "partTime", "civilServant"] } } },
          "then": { "required": ["healthInsurance", "pensionCategory", "employer", "salary"] }
        },
        { "if": { "properties": { "type": { "const": "selfEmployed" } } }, "then": { "required": ["business"] } }
      ]
    },
    "account": {
      "description": "0008 の9: 資産の器（計算に使う部分）",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "owner", "marketValue", "asOf", "contributions"],
      "properties": {
        "id": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
        "kind": {
          "title": "器の種類",
          "x-item": "account.kind",
          "enum": ["deposit", "taxable", "nisa", "juniorNisa", "childNisa", "legacyNisa", "ideco", "corporateDc", "zaikei", "esop", "fxDeposit", "insurance", "realEstate"]
        },
        "owner": { "title": "名義の構成員", "x-item": "account.owner", "$ref": "urn:financia:schema:common#/$defs/uuid" },
        "marketValue": { "title": "時価", "x-item": "account.marketValue", "$ref": "urn:financia:schema:common#/$defs/boxYen" },
        "costBasis": { "title": "取得価額", "x-item": "account.costBasis", "$ref": "urn:financia:schema:common#/$defs/boxYen" },
        "asOf": { "title": "時価の時点", "x-item": "account.asOf", "$ref": "urn:financia:schema:common#/$defs/yearMonth" },
        "contributions": {
          "title": "積立・掛金",
          "x-item": "account.contributions",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "monthly"],
            "properties": {
              "from": { "$ref": "urn:financia:schema:common#/$defs/timepoint" },
              "to": { "$ref": "#/$defs/timepointOrNull" },
              "monthly": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
              "tranche": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" }
            }
          }
        }
      }
    },
    "insuranceContract": {
      "description": "0008 の10: 保険契約（保険料控除の計算に使う部分）",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "template", "policyholder", "insured", "contractDate", "currency", "premium", "deductionCategory"],
      "properties": {
        "id": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
        "template": { "title": "保険の種類のひな形", "x-item": "insurance.template", "type": "string", "pattern": "^insurance\\.[a-z][a-zA-Z0-9]*$" },
        "policyholder": { "title": "契約者", "x-item": "insurance.policyholder", "$ref": "urn:financia:schema:common#/$defs/uuid" },
        "insured": { "title": "被保険者", "x-item": "insurance.insured", "$ref": "urn:financia:schema:common#/$defs/uuid" },
        "contractDate": { "title": "契約の年月", "x-item": "insurance.contractDate", "$ref": "urn:financia:schema:common#/$defs/yearMonth" },
