        "id": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
        "member": { "title": "納める構成員（国民健康保険は世帯主）", "x-item": "premiumAssessment.member", "$ref": "urn:financia:schema:common#/$defs/uuid" },
        "kind": { "title": "保険料の種類", "x-item": "premiumAssessment.kind", "enum": ["nationalHealth", "lateElderly", "careFirst"] },
        "fiscalYear": { "title": "年度", "x-item": "premiumAssessment.fiscalYear", "$ref": "urn:financia:schema:common#/$defs/year" },
        "amount": { "title": "年額", "x-item": "premiumAssessment.amount", "$ref": "urn:financia:schema:common#/$defs/boxYen" }
      }
