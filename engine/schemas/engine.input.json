    "pensionRecord": {
      "description": "公的年金の加入の記録。kind で型を選ぶ: statementUnder50（ねんきん定期便・50歳未満。加入実績に応じた額）、statementOver50（ねんきん定期便・50歳以上。60歳まで続けたときの見込額）、receiving（受給中の年金額の通知）、history（加入歴からの推計）、projection（65歳からの見込額だけを直接入れる）",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "member", "kind", "asOf"],
      "properties": {
        "id": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
        "member": { "title": "加入者", "x-item": "pensionRecord.member", "$ref": "urn:financia:schema:common#/$defs/uuid" },
        "kind": { "title": "記録の型", "x-item": "pensionRecord.kind", "enum": ["statementUnder50", "statementOver50", "receiving", "history", "projection"] },
        "asOf": { "title": "記録の時点（定期便の作成の月・通知の年月・加入歴の終わりの月）。この月より後はエンジンが働き方の期間から足す", "x-item": "pensionRecord.asOf", "$ref": "urn:financia:schema:common#/$defs/yearMonth" },
        "months": {
          "title": "加入期間の月数（定期便の加入期間の欄）",
          "x-item": "pensionRecord.months",
          "type": "object",
          "additionalProperties": false,
          "required": ["basic", "employee"],
          "properties": {
            "basic": { "title": "老齢基礎年金の額に反映する月数（第1号の納付済・第3号・第2号の20〜59歳）", "type": "integer", "minimum": 0, "maximum": 600 },
            "employee": { "title": "厚生年金の加入月数", "type": "integer", "minimum": 0, "maximum": 900 },
            "employee2059": { "title": "うち20〜59歳の厚生年金の月数（経過的加算。省略は employee と basic の小さい方）", "type": "integer", "minimum": 0, "maximum": 480 },
            "qualifying": { "title": "受給資格期間の月数（免除・合算対象期間を含む。省略は basic）", "type": "integer", "minimum": 0, "maximum": 900 }
          }
        },
        "amounts": {
          "title": "置き換え口: 記録の年金額（年額）",
          "x-item": "pensionRecord.amounts",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "basic": { "title": "老齢基礎年金", "$ref": "urn:financia:schema:common#/$defs/boxYen" },
            "employee": { "title": "老齢厚生年金（報酬比例部分）", "$ref": "urn:financia:schema:common#/$defs/boxYen" },
            "transitional": { "title": "経過的加算", "$ref": "urn:financia:schema:common#/$defs/boxYen" },
            "special": { "title": "特別支給の老齢厚生年金（報酬比例部分）", "$ref": "urn:financia:schema:common#/$defs/boxYen" }
          }
        },
        "history": {
          "title": "加入歴（history の型）",
          "x-item": "pensionRecord.history",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "category"],
            "properties": {
              "from": { "$ref": "urn:financia:schema:common#/$defs/yearMonth" },
              "to": { "$ref": "urn:financia:schema:common#/$defs/yearMonth" },
              "category": { "enum": ["national1", "national1Unpaid", "national3", "employee"] },
              "averageRemuneration": {
                "title": "平均標準報酬額（2003年3月以前は平均標準報酬月額。いまの賃金の水準に直した額とみなす）",
                "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen"
              },
              "averageRemunerationAtTime": {
                "title": "当時の平均標準報酬額（2003年3月以前は平均標準報酬月額）。記録の年度の再評価率（生年月日・報酬の月）でいまの水準に直す",
                "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen"
              }
            },
            "not": { "required": ["averageRemuneration", "averageRemunerationAtTime"] }
          }
        },
        "claim": {
          "title": "受給を始める月（基礎と厚生を別々に。繰上げ・繰下げ。省略は65歳に達した月の翌月）",
          "x-item": "pensionRecord.claim",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "basic": { "$ref": "urn:financia:schema:common#/$defs/timepoint" },
            "employee": { "$ref": "urn:financia:schema:common#/$defs/timepoint" }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "enum": ["statementUnder50", "statementOver50"] } } }, "then": { "required": ["months", "amounts"] } },
        { "if": { "properties": { "kind": { "enum": ["receiving", "projection"] } } }, "then": { "required": ["amounts"] } },
        { "if": { "properties": { "kind": { "const": "history" } } }, "then": { "required": ["history"] } }
      ]
    },
    "premiumAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "member", "kind", "fiscalYear", "amount"],
