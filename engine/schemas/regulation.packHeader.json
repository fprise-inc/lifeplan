{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:financia:schema:regulation.packHeader",
  "title": "パックの名札（0007 の3。pack.yaml）",
  "type": "object",
  "additionalProperties": false,
  "required": ["packId", "formatVersion", "version", "features", "title", "requires", "license"],
  "if": { "required": ["fictionalOf"] },
  "then": { "required": ["fictional"], "properties": { "fictional": { "const": true } } },
  "properties": {
    "packId": { "type": "string", "pattern": "^(regulation|master)(\\.[a-z][a-zA-Z0-9]*)+$" },
    "formatVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "version": { "$ref": "urn:financia:schema:regulation.value#/$defs/packVersion" },
    "features": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9.]*$" } },
    "title": { "type": "string", "minLength": 1 },
    "fictional": {
      "description": "0007 の追記: 架空の見本データのパック。製品のデータには付けない",
      "type": "boolean"
    },
    "fictionalOf": {
      "description": "架空のパックが代わりをする製品のパックのID（テスト用。値ID の test. を外した ID で引ける。PR の提案）",
      "type": "string",
      "pattern": "^regulation(\\.[a-z][a-zA-Z0-9]*)+$"
    },
    "requires": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-zA-Z0-9]*)+$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values", "sources"],
      "properties": {
        "values": { "type": "string", "minLength": 1 },
        "sources": { "type": "string", "minLength": 1 }
      }
    }
  }
}
