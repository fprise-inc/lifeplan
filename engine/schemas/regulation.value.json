{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:financia:schema:regulation.value",
  "title": "制度の値の定義（0007 の4。YAML の1ファイル）",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "unit", "kind", "basis", "entries"],
  "properties": {
    "id": { "$ref": "urn:financia:schema:common#/$defs/dottedId" },
    "title": { "type": "string", "minLength": 1 },
    "unit": { "enum": ["JPY", "rate", "months", "count", "years", "yearMonth", "rounding"] },
    "kind": { "enum": ["constant", "bracketTable", "gradeTable", "formula", "indexed", "rounding", "componentSwitch", "periodTable"] },
    "basis": { "$ref": "#/$defs/basis" },
    "ageSwitch": { "oneOf": [{ "type": "null" }, { "$ref": "urn:financia:schema:common#/$defs/ageSwitch" }] },
    "rounding": { "oneOf": [{ "type": "null" }, { "$ref": "urn:financia:schema:common#/$defs/dottedId" }] },
    "linkage": { "enum": ["none", "scheduled", "indexed", "cpiLinked"] },
    "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "rounding" } } },
      "then": {
        "properties": {
          "unit": { "const": "rounding" },
          "entries": { "items": { "properties": { "value": { "$ref": "#/$defs/roundingValue" } } } }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "constant" }, "unit": { "const": "JPY" } } },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "properties": {
                "value": { "oneOf": [{ "$ref": "urn:financia:schema:common#/$defs/yen" }, { "const": "notApplicable" }] }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "constant" }, "unit": { "const": "rate" } } },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "properties": {
                "value": { "oneOf": [{ "$ref": "urn:financia:schema:common#/$defs/rate" }, { "const": "notApplicable" }] }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "gradeTable" } } },
      "then": {
        "properties": {
          "unit": { "const": "JPY" },
          "entries": {
            "items": {
              "properties": {
                "value": { "oneOf": [{ "$ref": "#/$defs/gradeValue" }, { "const": "notApplicable" }] }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "constant" }, "unit": { "enum": ["count", "years", "months"] } }, "required": ["kind", "unit"] },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "properties": {
                "value": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "const": "notApplicable" }] }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "bracketTable" } } },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "properties": {
                "value": { "oneOf": [{ "$ref": "#/$defs/bracketValue" }, { "const": "notApplicable" }] }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "periodTable" } } },
      "then": {
        "properties": {
          "unit": { "const": "rate" },
          "entries": {
            "items": {
              "properties": {
                "value": { "oneOf": [{ "$ref": "#/$defs/periodValue" }, { "const": "notApplicable" }] }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "basis": {
      "description": "0003 の9: 値を選ぶ基準。引数のない型は文字列で書いてよい",
      "oneOf": [
        { "enum": ["incomeYear", "month", "birthDate", "priorYearIncome", "fiscalYear"] },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "enum": ["incomeYear", "month", "birthDate"] } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "priorYearIncome" },
            "switchMonth": { "type": "integer", "minimum": 1, "maximum": 12 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "fiscalYear" },
            "startMonth": { "type": "integer", "minimum": 1, "maximum": 12 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "anchor"],
          "properties": {
            "type": { "const": "anchor" },
            "anchor": { "enum": ["moveIn", "contract", "acquisition", "enrollment", "benefitStart"] }
          }
        }
      ]
    },
    "packVersion": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]+\\.[0-9]+$" },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rev",
        "appliesFrom",
        "appliesTo",
        "enforcedOn",
        "status",
        "jurisdiction",
        "conditions",
        "value",
        "sources",
        "recordedIn",
        "supersededIn"
      ],
      "properties": {
        "rev": { "type": "integer", "minimum": 1 },
        "appliesFrom": { "$ref": "urn:financia:schema:common#/$defs/date" },
        "appliesTo": { "oneOf": [{ "type": "null" }, { "$ref": "urn:financia:schema:common#/$defs/date" }] },
        "enforcedOn": {
          "description": "施行日。原本で確かめる前（approval.method が pendingReview）で施行日が分からない行だけ null（PR の提案）。施行日そのものは分からないが「遅くともこの日には施行済み」と分かる行は {notAfter: 日付}（0007 の追記。例: e-Gov の改正履歴が始まる 2017-04-01 の版に、値を定める文言が既にある規定）",
          "oneOf": [
            { "type": "null" },
            { "$ref": "urn:financia:schema:common#/$defs/date" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["notAfter"],
              "properties": { "notAfter": { "$ref": "urn:financia:schema:common#/$defs/date" } }
            }
          ]
        },
        "milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "date"],
            "properties": {
              "kind": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
              "date": { "$ref": "urn:financia:schema:common#/$defs/date" }
            }
          }
        },
        "status": { "enum": ["proposed", "enacted"] },
        "scenarioId": { "$ref": "urn:financia:schema:common#/$defs/dottedId" },
        "jurisdiction": {
          "oneOf": [
            { "const": "national" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["level", "code"],
              "properties": {
                "level": { "enum": ["prefecture", "municipality", "insurer", "wideAreaUnion"] },
                "code": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
        "value": true,
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
        "recordedIn": { "$ref": "#/$defs/packVersion" },
        "supersededIn": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/packVersion" }] },
        "approval": {
          "description": "0007 の9・追記。reviewed は「公式の原本と、2つ以上の読み方（paths）で照らし合わせて一致した」こと（人の目による確認は要件にしない）。誰が（comparedBy。人なら役割、個人名は書かない）・どの道具で（tools）・いつ（comparedOn）照らし合わせたかを残す（3つの欄で書くか、note に「照合: …」と書く）。pendingReview は原本と照らし合わせる前。paths は読み取って一致を確かめた経路の数",
          "type": "object",
          "additionalProperties": false,
          "required": ["method"],
          "properties": {
            "method": { "enum": ["reviewed", "automated", "pendingReview"] },
            "keyId": { "type": "string" },
            "recordId": { "type": "string" },
            "paths": { "type": "integer", "minimum": 1, "maximum": 9 },
            "comparedBy": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9.-]*$" },
            "tools": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "comparedOn": { "$ref": "urn:financia:schema:common#/$defs/date" },
            "note": { "type": "string", "minLength": 1 }
          },
          "allOf": [
            { "if": { "properties": { "method": { "const": "pendingReview" } } }, "then": { "required": ["paths"] } },
            {
              "if": { "properties": { "method": { "const": "reviewed" } } },
              "then": {
                "required": ["paths"],
                "properties": { "paths": { "minimum": 2 } },
                "anyOf": [{ "required": ["comparedBy", "tools", "comparedOn"] }, { "required": ["note"] }]
              }
            }
          ]
        }
      },
      "if": { "properties": { "status": { "const": "proposed" } } },
      "then": { "required": ["scenarioId"] }
    },
    "condition": {
      "description": "0007 の6: 決まったキーに対する範囲・一致（AND だけ）",
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": { "enum": ["birthDate", "sex", "entitlementDate", "residenceStartYear", "contractDate", "giftDate"] },
        "from": { "oneOf": [{ "type": "null" }, { "type": "string" }, { "type": "integer" }] },
        "to": { "oneOf": [{ "type": "null" }, { "type": "string" }, { "type": "integer" }] },
        "equals": { "type": "string" }
      }
    },
    "roundingValue": {
      "description": "0002: 制度の端数処理（方式と単位）",
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "unit"],
      "properties": {
        "mode": { "enum": ["DOWN", "UP", "HALF_UP", "HALF_DOWN", "HALF_EVEN"] },
        "unit": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "periodValue": {
      "description": "0007 の追記（2回目の見直し）: 期間の表（再評価率など）。報酬などの月が from〜to（両端を含む。to が null は上限なし）の行の率 rate。行は from の昇順で重ならない。生年月日の区分は行（entry）の条件 birthDate で、年度は appliesFrom・appliesTo で分ける（生年月日×期間の2次元の表）",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "rate"],
        "properties": {
          "from": { "$ref": "urn:financia:schema:common#/$defs/yearMonth" },
          "to": { "oneOf": [{ "type": "null" }, { "$ref": "urn:financia:schema:common#/$defs/yearMonth" }] },
          "rate": { "$ref": "urn:financia:schema:common#/$defs/rate" }
        }
      }
    },
    "gradeValue": {
      "description": "0007 の追記: 等級表（標準報酬月額表など）。報酬月額が from 以上 below 未満なら等級 grade・額 amount。grade は1から1ずつ、from は前の行の below と同じ、最後の行だけ below が null",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["grade", "amount", "from", "below"],
        "properties": {
          "grade": { "type": "integer", "minimum": 1 },
          "amount": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
          "from": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
          "below": { "oneOf": [{ "type": "null" }, { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" }] }
        }
      }
    },
    "bracketValue": {
      "description": "段階表。upTo（以下）の昇順、最後は null",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["upTo"],
        "properties": {
          "upTo": { "oneOf": [{ "type": "null" }, { "$ref": "urn:financia:schema:common#/$defs/yen" }] },
          "amount": { "$ref": "urn:financia:schema:common#/$defs/yen" },
          "rate": { "$ref": "urn:financia:schema:common#/$defs/rate" }
        }
      }
    },
    "source": {
      "description": "0007 の9: 出典。fictional は架空の見本データ（test. の値）だけに使う",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "url", "retrievedAt", "sha256"],
          "properties": {
            "type": { "const": "web" },
            "url": { "type": "string", "pattern": "^https://" },
            "retrievedAt": { "$ref": "urn:financia:schema:common#/$defs/date" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "locator": { "type": "string" },
            "quote": { "type": "string" }
          }
        },
        {
          "description": "原本を取れず、公式のドメインに限った検索の結果で読んだもの。原本の指紋は無い（PR の提案）。quote は検索結果の題名に出た原文の抜粋",
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "url", "retrievedAt", "retrievedVia"],
          "properties": {
            "type": { "const": "web" },
            "url": { "type": "string", "pattern": "^https://" },
            "retrievedAt": { "$ref": "urn:financia:schema:common#/$defs/date" },
            "retrievedVia": { "const": "searchExcerpt" },
            "locator": { "type": "string" },
            "quote": { "type": "string" },
            "note": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "lawNumber"],
          "properties": {
            "type": { "const": "law" },
            "lawNumber": { "type": "string", "minLength": 1 },
            "egovRevisionId": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "title", "publisher", "publishedOn", "sha256"],
          "properties": {
            "type": { "const": "document" },
            "title": { "type": "string", "minLength": 1 },
            "publisher": { "type": "string", "minLength": 1 },
            "publishedOn": { "$ref": "urn:financia:schema:common#/$defs/date" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "locator": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "note"],
          "properties": {
            "type": { "const": "fictional" },
            "note": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
