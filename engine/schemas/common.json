{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:financia:schema:common",
  "title": "共通の型（0002・0003・0004）",
  "$defs": {
    "yen": {
      "description": "0002: 円の金額。最小単位（円）の整数",
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "x-unit": "JPY"
    },
    "nonNegativeYen": {
      "allOf": [{ "$ref": "#/$defs/yen" }, { "minimum": 0 }]
    },
    "money": {
      "description": "0002: 外貨になりうる金額",
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "rate": {
      "description": "0002: 率。10進の文字列、小数12桁まで、指数表記なし",
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]{1,12})?$"
    },
    "yearMonth": {
      "description": "0003: 年月",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "date": {
      "description": "暦の日付（制度データの適用期間など）",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "year": { "type": "integer", "minimum": 1900, "maximum": 2200 },
    "dottedId": {
      "description": "0004: 点区切りのID",
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-zA-Z0-9]*)+$"
    },
    "rowId": {
      "allOf": [{ "$ref": "#/$defs/dottedId" }, { "pattern": "^cf\\." }]
    },
    "uuid": {
      "description": "0004: 乱数ID（UUID 第4版、小文字・ハイフンつき）",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "ageSwitch": {
      "enum": ["reachMonth", "monthAfterReach", "birthdayMonth", "monthAfterBirthday", "firstMarch31AfterReach", "schoolYear", "schoolYearJanuary"]
    },
    "birth": {
      "description": "0012: 生年月＋1日生まれか",
      "type": "object",
      "additionalProperties": false,
      "required": ["birthYearMonth", "bornOnFirst"],
      "properties": {
        "birthYearMonth": { "$ref": "#/$defs/yearMonth" },
        "bornOnFirst": { "type": "boolean" }
      }
    },
    "timepoint": {
      "description": "0003 の6: 時点の型",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["at"],
          "properties": { "at": { "$ref": "#/$defs/yearMonth" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["memberAge"],
          "properties": {
            "memberAge": {
              "type": "object",
              "additionalProperties": false,
              "required": ["member", "years"],
              "properties": {
                "member": { "$ref": "#/$defs/uuid" },
                "years": { "type": "integer", "minimum": 0, "maximum": 130 },
                "months": { "type": "integer", "minimum": 0, "maximum": 11 },
                "ageSwitch": { "$ref": "#/$defs/ageSwitch" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["event"],
          "properties": {
            "event": { "$ref": "#/$defs/uuid" },
            "offset": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "years": { "type": "integer", "minimum": -130, "maximum": 130 },
                "months": { "type": "integer", "minimum": -1560, "maximum": 1560 }
              }
            }
          }
        }
      ]
    },
    "yearSeries": {
      "description": "0006 の6: 年ごとの列（定数は全部の年が同じ値の特別な場合）",
      "type": "object",
      "additionalProperties": false,
      "required": ["default"],
      "properties": {
        "default": { "$ref": "#/$defs/rate" },
        "byYear": {
          "type": "object",
          "propertyNames": { "pattern": "^[0-9]{4}$" },
          "additionalProperties": { "$ref": "#/$defs/rate" }
        }
      }
    },
    "valueBoxMeta": {
      "description": "0008 の2: 値の箱の共通の欄。値（value）の型は boxYen などで決める",
      "type": "object",
      "required": ["state", "origin"],
      "properties": {
        "state": { "enum": ["confirmed", "unknown", "notApplicable", "estimated"] },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["manual", "hearing", "import", "ai", "auto", "override"] },
            "ref": { "type": "string", "minLength": 1 },
            "connector": { "type": "string", "minLength": 1 }
          }
        },
        "approval": {
          "description": "0008 の2: 承認できるのは FP だけ",
          "type": "object",
          "additionalProperties": false,
          "required": ["by", "at"],
          "properties": {
            "by": { "const": "fp" },
            "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?(Z|[+-][0-9]{2}:[0-9]{2})$" },
            "candidate": { "$ref": "#/$defs/uuid" }
          }
        },
        "estimate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "basis"],
          "properties": {
            "method": { "description": "推定の出し方: statistic（統計の値）・derived（他の値からの逆算）・officeDefault（事務所のひな形）・statementAverage（明細の月平均）・statementAnnual（明細の年1回の支払い。0034）・standard（標準の値・目安のボタン・仮の値。0035 の3）", "enum": ["statistic", "derived", "officeDefault", "statementAverage", "statementAnnual", "standard"] },
            "basis": { "type": "string", "minLength": 1 }
          }
        },
        "certainty": { "description": "0035 の3: 値の確かさ（document 書類で確認・declared 本人の申告・rough 概算）。計算には使わない", "enum": ["document", "declared", "rough"] }
      },
      "allOf": [
        { "if": { "properties": { "state": { "const": "confirmed" } } }, "then": { "required": ["value"] } },
        { "if": { "properties": { "state": { "const": "estimated" } } }, "then": { "required": ["value", "estimate"] } },
        { "if": { "properties": { "state": { "const": "unknown" } } }, "then": { "required": ["substitute"], "not": { "required": ["value"] } } },
        { "if": { "properties": { "state": { "const": "notApplicable" } } }, "then": { "not": { "anyOf": [{ "required": ["value"] }, { "required": ["substitute"] }] } } },
        {
          "if": { "properties": { "origin": { "properties": { "kind": { "enum": ["hearing", "import", "ai"] } } } } },
          "then": { "required": ["approval"] }
        }
      ]
    },
    "boxYen": {
      "description": "0008 の2: 円の金額の値の箱",
      "allOf": [{ "$ref": "#/$defs/valueBoxMeta" }],
      "properties": {
        "value": { "$ref": "#/$defs/nonNegativeYen" },
        "state": true,
        "origin": true,
        "approval": true,
        "estimate": true,
        "certainty": true,
        "substitute": { "allOf": [{ "$ref": "#/$defs/boxYen" }, { "properties": { "state": { "const": "estimated" } } }] }
      },
      "additionalProperties": false
    },
    "boxBoolean": {
      "description": "0008 の2: 真偽の値の箱（導いた結果の上書きなど）",
      "allOf": [{ "$ref": "#/$defs/valueBoxMeta" }],
      "properties": {
        "value": { "type": "boolean" },
        "state": true,
        "origin": true,
        "approval": true,
        "estimate": true,
        "certainty": true,
        "substitute": { "allOf": [{ "$ref": "#/$defs/boxBoolean" }, { "properties": { "state": { "const": "estimated" } } }] }
      },
      "additionalProperties": false
    },
    "boxRate": {
      "description": "0008 の2: 率の値の箱",
      "allOf": [{ "$ref": "#/$defs/valueBoxMeta" }],
      "properties": {
        "value": { "$ref": "#/$defs/rate" },
        "state": true,
        "origin": true,
        "approval": true,
        "estimate": true,
        "certainty": true,
        "substitute": { "allOf": [{ "$ref": "#/$defs/boxRate" }, { "properties": { "state": { "const": "estimated" } } }] }
      },
      "additionalProperties": false
    },
    "valueState": {
      "description": "0035 の3: 値の箱を持たない値の状態の1行（値の箱から value・substitute を除いた形）。わからないの行は、欄に入れた代わりの値の根拠として estimate を持つ",
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "origin"],
      "properties": {
        "state": { "enum": ["confirmed", "unknown", "notApplicable", "estimated"] },
        "origin": { "$ref": "#/$defs/valueBoxMeta/properties/origin" },
        "approval": { "$ref": "#/$defs/valueBoxMeta/properties/approval" },
        "estimate": { "$ref": "#/$defs/valueBoxMeta/properties/estimate" },
        "certainty": { "$ref": "#/$defs/valueBoxMeta/properties/certainty" }
      },
      "allOf": [
        { "if": { "properties": { "state": { "enum": ["estimated", "unknown"] } } }, "then": { "required": ["estimate"] } },
        {
          "if": { "properties": { "origin": { "properties": { "kind": { "enum": ["hearing", "import", "ai"] } } } } },
          "then": { "required": ["approval"] }
        }
      ]
    },
    "valueStates": {
      "description": "0035 の3: 値の状態の欄。鍵は「入力項目ID」か「入力項目ID/場所」（場所は 0036 の2 の at を / でつないだもの）。値の箱を持つ値は箱の中に持ち、ここには書かない。計算には使わない",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-zA-Z0-9]*)+(/[^/]+)*$" },
      "additionalProperties": { "$ref": "#/$defs/valueState" }
    },
    "flow": {
      "description": "0003 の2: 支払月ごとのお金の動き1件",
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "ym", "amount", "accrualYear", "formula"],
      "properties": {
        "row": { "$ref": "#/$defs/rowId" },
        "ym": { "$ref": "#/$defs/yearMonth" },
        "amount": { "$ref": "#/$defs/yen" },
        "accrualYear": { "$ref": "#/$defs/year" },
        "member": { "$ref": "#/$defs/uuid" },
        "object": { "$ref": "#/$defs/uuid" },
        "formula": { "$ref": "#/$defs/dottedId" }
      }
    },
    "annualRow": {
      "description": "年ごとの行（残高・運用益など、年に1回決まる値）",
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "year", "amount", "formula"],
      "properties": {
        "row": { "$ref": "#/$defs/rowId" },
        "year": { "$ref": "#/$defs/year" },
        "amount": { "$ref": "#/$defs/yen" },
        "member": { "$ref": "#/$defs/uuid" },
        "object": { "$ref": "#/$defs/uuid" },
        "formula": { "$ref": "#/$defs/dottedId" }
      }
    }
  }
}
