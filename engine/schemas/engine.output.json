{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:financia:schema:engine.output",
  "title": "エンジン全体の出力（値＋根拠の記録。0006 の7）",
  "oneOf": [{ "$ref": "#/$defs/result" }, { "$ref": "#/$defs/error" }],
  "$defs": {
    "summary": {
      "description": "表から作る要約（0008 の追記）: 表の期間の合計（案どうしの比較）と、FP顧問料の年ごとの額・累計・契約ごとの合計（契約は物の ID。顧問料を除いた場合との差は enabled: false の要求と比べて出す）",
      "type": "object",
      "additionalProperties": false,
      "required": ["totals"],
      "properties": {
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["income", "taxSi", "expense", "net"],
          "properties": {
            "income": { "$ref": "urn:financia:schema:common#/$defs/yen" },
            "taxSi": { "$ref": "urn:financia:schema:common#/$defs/yen" },
            "expense": { "$ref": "urn:financia:schema:common#/$defs/yen" },
            "net": { "$ref": "urn:financia:schema:common#/$defs/yen" }
          }
        },
        "insurance": { "$ref": "#/$defs/insurance" },
        "gifts": { "$ref": "#/$defs/gifts" },
        "outsideWallets": { "$ref": "#/$defs/outsideWallets" },
        "childScholarships": { "$ref": "#/$defs/childScholarships" },
        "realEstate": {
          "description": "住まい以外の不動産（中身を入れた不動産の器）の物件ごとの年末の評価額（土地・建物）・不動産所得の内訳（計算基準年の2年前から）・売却。asset.realEstate の出力の properties のまま（plan.cashflow の details から。0009 の追記）。持っていなければ欄が無い",
          "$ref": "urn:financia:schema:component:asset.realEstate.output#/properties/properties"
        },
        "realEstateAnalysis": {
          "description": "収益不動産の分析の数字（物件ごと・年ごとの利回り・返済比率・手残りなどと全物件の合計。asset.realEstateAnalysis の出力のまま。plan.cashflow の details から。0082）。持っていなければ欄が無い",
          "$ref": "urn:financia:schema:component:asset.realEstateAnalysis.output"
        },
        "advisoryFee": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "byYear", "contracts"],
          "properties": {
            "total": { "$ref": "urn:financia:schema:common#/$defs/yen" },
            "byYear": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["year", "amount", "cumulative"],
                "properties": { "year": { "$ref": "urn:financia:schema:common#/$defs/year" }, "amount": { "$ref": "urn:financia:schema:common#/$defs/yen" }, "cumulative": { "$ref": "urn:financia:schema:common#/$defs/yen" } }
              }
            },
            "contracts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["total"],
                "properties": { "object": { "$ref": "urn:financia:schema:common#/$defs/uuid" }, "member": { "$ref": "urn:financia:schema:common#/$defs/uuid" }, "total": { "$ref": "urn:financia:schema:common#/$defs/yen" } }
              }
            }
          }
        }
      }
    },
    "inheritanceTax": {
      "description": "相続税の目安（0039）。時点ごとに、亡くなる人・財産の内訳・法定相続人・基礎控除・税の総額・配偶者の軽減・納める額（世帯の人と世帯の外の相続人）。お金の流れには入れない（表示だけ）。amount は使う額（FP が入れた額があればその額）",
      "type": "object",
      "additionalProperties": false,
      "required": ["points", "notIncluded"],
      "properties": {
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["point", "decedent", "month", "valuationYear", "status", "assets", "heirs", "heirCount", "heirCountOverridden", "basicDeduction", "taxableEstate", "totalTax", "spouseReduction", "settlementCredit", "byHeir", "payable", "payableHousehold", "payableOutside", "refund", "noTax", "margin", "amount", "state", "cautions"],
            "properties": {
              "point": { "enum": ["now", "bothAfter", "contingency"] },
              "decedent": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
              "month": { "description": "亡くなる月（いま＝計算基準月、二人とも亡くなった後＝表の最後の年の12月）", "$ref": "urn:financia:schema:common#/$defs/yearMonth" },
              "valuationYear": { "description": "財産を見る年（その年の年末の残高。いまの金融資産は入力の時価）", "$ref": "urn:financia:schema:common#/$defs/year" },
              "status": { "description": "ok は計算した、noHeirs は相続人がいない（税を出さない）、noData は制度の値が無い", "enum": ["ok", "noHeirs", "noData"] },
              "assets": {
                "type": "object",
                "additionalProperties": false,
                "required": ["financial", "realEstateMarket", "realEstate", "other", "insurance", "insuranceExempt", "retirement", "retirementExempt", "settlementGifts", "debts", "funeral", "taxablePrice"],
                "properties": {
                  "financial": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                  "realEstateMarket": { "description": "不動産の時価", "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                  "realEstate": { "description": "不動産の評価（時価×評価の割合）", "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                  "other": { "description": "車・その他の資産・保険の契約の権利（解約返戻金）など", "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                  "insurance": { "description": "死亡保険金（亡くなる人が契約者で被保険者の契約）", "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                  "insuranceExempt": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                  "retirement": { "description": "死亡退職金（確定拠出年金・小規模企業共済の残高を含む）", "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                  "retirementExempt": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                  "settlementGifts": { "description": "相続時精算課税で贈与した財産（年ごとの基礎控除の後）", "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                  "debts": { "description": "債務（団信で消える分を除く。亡くなった人がまだ払っていない所得の税を含む）", "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                  "unpaidTaxes": { "description": "債務のうち、亡くなった人がまだ払っていない死亡の年までの所得の税（任意。約束の版 1.1）", "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                  "funeral": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                  "taxablePrice": { "description": "課税価格の合計（1,000円未満切り捨て）", "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" }
                }
              },
              "heirs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["member", "relation", "outside", "counted"],
                  "properties": {
                    "member": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
                    "relation": { "enum": ["spouse", "child", "grandchild", "parent", "grandparent", "sibling"] },
                    "outside": { "description": "世帯の外の家族か", "type": "boolean" },
                    "share": { "description": "法定相続分（分数の文字列。数に入れない養子は無い）", "type": "string", "pattern": "^[0-9]+/[0-9]+$" },
                    "counted": { "description": "法定相続人の数に入れるか（養子の数の制限）", "type": "boolean" },
                    "adopted": { "type": "boolean" },
                    "representing": { "description": "代襲相続人のとき、代わる人（先に亡くなった子）", "$ref": "urn:financia:schema:common#/$defs/uuid" }
                  }
                }
              },
              "heirCount": { "type": "integer", "minimum": 0 },
              "heirCountOverridden": { "type": "boolean" },
              "basicDeduction": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
              "taxableEstate": { "description": "課税遺産総額", "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
              "totalTax": { "description": "相続税の総額", "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
              "spouseReduction": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
              "settlementCredit": { "description": "相続時精算課税で払った贈与税（引く額）", "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
              "byHeir": {
                "description": "人ごと（法定相続分どおりに分けたとする）。法定相続人の数を直したときは、配偶者のほかをまとめた1行（member なし・count）",
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["outside", "acquisition", "tax", "spouseReduction", "credit", "payable", "refund"],
                  "properties": {
                    "member": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
                    "count": { "type": "integer", "minimum": 1 },
                    "outside": { "type": "boolean" },
                    "acquisition": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                    "tax": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                    "spouseReduction": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                    "credit": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                    "payable": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                    "refund": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" }
                  }
                }
              },
              "payable": { "description": "納める額の合計（目安）", "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
              "payableHousehold": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
              "payableOutside": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
              "refund": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
              "noTax": { "description": "かからない見込み（課税価格の合計が基礎控除以下）", "type": "boolean" },
              "margin": { "description": "基礎控除−課税価格の合計（正なら基礎控除までの余り）", "$ref": "urn:financia:schema:common#/$defs/yen" },
              "amount": { "description": "使う額（FP が入れた額があればその額、無ければ目安の納める額）", "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
              "state": { "description": "estimated は目安、confirmed は FP が入れた額", "enum": ["estimated", "confirmed"] },
              "cautions": { "description": "当たりそうな、入れていない決まり（2割加算・小規模宅地等の特例・養子の数の制限など）", "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "notIncluded": { "description": "目安に含めていない決まり（いつも同じ一覧）", "type": "array", "items": { "type": "string" } }
      }
    },
    "protectionBreakdown": {
      "description": "必要保障額の内訳（0054）。必要な資金は毎年の分（expenses の合計）と一時の分（lump の合計）、準備できる資金も毎年の分（resources）と一時の分（lumpResources）。合計は年の expenses・resources と同じ。creditLife は団信で消える住宅ローンの返済の額（住居費から除いた額。見せるだけ）",
      "type": "object",
      "additionalProperties": false,
      "required": ["expenses", "lump", "resources", "lumpResources", "creditLife"],
      "properties": {
        "expenses": {
          "type": "object",
          "additionalProperties": false,
          "required": ["living", "housing", "education", "premiums", "care", "taxSi", "other"],
          "properties": {
            "living": { "description": "遺族の生活費", "$ref": "urn:financia:schema:common#/$defs/yen" },
            "housing": { "description": "住居費（団信で消えるローンを除く）", "$ref": "urn:financia:schema:common#/$defs/yen" },
            "education": { "description": "教育費（保育料を含む）", "$ref": "urn:financia:schema:common#/$defs/yen" },
            "premiums": { "description": "保険料（亡くなった人が被保険者の契約を除く）", "$ref": "urn:financia:schema:common#/$defs/yen" },
            "care": { "description": "介護の費用", "$ref": "urn:financia:schema:common#/$defs/yen" },
            "taxSi": { "description": "遺族の税と社会保険料", "$ref": "urn:financia:schema:common#/$defs/yen" },
            "other": { "description": "そのほか（周期的な支出・FP顧問料・遺族の支出・車）", "$ref": "urn:financia:schema:common#/$defs/yen" }
          }
        },
        "lump": {
          "type": "object",
          "additionalProperties": false,
          "required": ["funeral", "reserve"],
          "properties": {
            "funeral": { "description": "整理資金", "$ref": "urn:financia:schema:common#/$defs/yen" },
            "reserve": { "description": "予備の生活資金", "$ref": "urn:financia:schema:common#/$defs/yen" }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["survivorPension", "survivorIncome", "publicSupport"],
          "properties": {
            "survivorPension": { "description": "遺族年金", "$ref": "urn:financia:schema:common#/$defs/yen" },
            "survivorIncome": { "description": "遺族の収入（給与・年金など）", "$ref": "urn:financia:schema:common#/$defs/yen" },
            "publicSupport": { "description": "児童手当・教育の公的支援", "$ref": "urn:financia:schema:common#/$defs/yen" }
          }
        },
        "lumpResources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["retirementAllowance", "dcLump", "condolence"],
          "properties": {
            "retirementAllowance": { "description": "死亡退職金", "$ref": "urn:financia:schema:common#/$defs/yen" },
            "dcLump": { "description": "確定拠出年金の死亡一時金", "$ref": "urn:financia:schema:common#/$defs/yen" },
            "condolence": { "description": "弔慰金", "$ref": "urn:financia:schema:common#/$defs/yen" },
            "mutualAidLump": { "description": "1.2: 小規模企業共済の死亡を事由とする共済金（0173）", "$ref": "urn:financia:schema:common#/$defs/yen" }
          }
        },
        "creditLife": { "$ref": "urn:financia:schema:common#/$defs/yen" }
      }
    },
    "protection": {
      "description": "6.3: 必要保障額の推移（構成員ごとに「この年に亡くなったら」を1年ずつずらす）。積み上げ方式は金融資産を含む額と含まない額、逆算方式は資産が尽きない最小の保険金。加入中の死亡保険金と並べる",
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "members"],
      "properties": {
        "method": { "enum": ["accumulation", "reverse"] },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["member", "years"],
            "properties": {
              "member": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
              "survivor": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
              "years": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["year", "death", "horizon", "need", "needWithAssets", "coverage"],
                  "properties": {
                    "year": { "$ref": "urn:financia:schema:common#/$defs/year" },
                    "death": { "$ref": "urn:financia:schema:common#/$defs/yearMonth" },
                    "horizon": { "$ref": "urn:financia:schema:common#/$defs/year" },
                    "need": { "description": "必要保障額（金融資産を含まない。積み上げ方式は不足額の累計、逆算方式は最小の保険金）", "$ref": "urn:financia:schema:common#/$defs/yen" },
                    "needWithAssets": { "description": "金融資産（亡くなった年の前の年末）を準備できる資金に含めた額", "$ref": "urn:financia:schema:common#/$defs/yen" },
                    "coverage": { "description": "加入中の死亡保険金（一時金と収入保障の残りの合計）", "$ref": "urn:financia:schema:common#/$defs/yen" },
                    "expenses": { "$ref": "urn:financia:schema:common#/$defs/yen" },
                    "resources": { "$ref": "urn:financia:schema:common#/$defs/yen" },
                    "lumpSum": { "$ref": "urn:financia:schema:common#/$defs/yen" },
                    "assets": { "$ref": "urn:financia:schema:common#/$defs/yen" },
                    "breakdown": { "$ref": "#/$defs/protectionBreakdown" },
                    "coverageBy": {
                      "description": "加入中の死亡保険金の契約ごとの内訳（0の契約は入れない。0054）",
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["object", "amount"],
                        "properties": { "object": { "$ref": "urn:financia:schema:common#/$defs/uuid" }, "amount": { "$ref": "urn:financia:schema:common#/$defs/yen" } }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "insurance": {
      "description": "6.8: 保障内容一覧と払込保険料の推移の材料（商品を特定しない形）",
      "type": "object",
      "additionalProperties": false,
      "required": ["contracts", "byYear"],
      "properties": {
        "contracts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["object", "template", "policyholder", "insured", "coverages"],
            "properties": {
              "object": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
              "template": { "type": "string" },
              "policyholder": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
              "insured": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
              "coverages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "role", "benefit", "amount"],
                  "properties": {
                    "id": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
                    "role": { "enum": ["main", "rider"] },
                    "benefit": { "type": "string" },
                    "amount": { "$ref": "urn:financia:schema:common#/$defs/yen" },
                    "from": { "$ref": "urn:financia:schema:common#/$defs/yearMonth" },
                    "to": { "$ref": "urn:financia:schema:common#/$defs/yearMonth" },
                    "insured": { "description": "この保障の被保険者（契約の被保険者と違うときだけ。0054）", "$ref": "urn:financia:schema:common#/$defs/uuid" }
                  }
                }
              }
            }
          }
        },
        "byYear": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["year", "object", "premium", "deathBenefit", "surrenderValue"],
            "properties": {
              "year": { "$ref": "urn:financia:schema:common#/$defs/year" },
              "object": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
              "premium": { "$ref": "urn:financia:schema:common#/$defs/yen" },
              "deathBenefit": { "$ref": "urn:financia:schema:common#/$defs/yen" },
              "surrenderValue": { "$ref": "urn:financia:schema:common#/$defs/yen" },
              "paid": { "description": "その年の年末までの払込保険料の累計（契約の月から。0054）", "$ref": "urn:financia:schema:common#/$defs/yen" },
              "others": {
                "description": "契約の被保険者でない人が被保険者の保障（家族型・家族特約）の、その人ごとの年末の死亡保障額（0054）",
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["member", "deathBenefit"],
                  "properties": { "member": { "$ref": "urn:financia:schema:common#/$defs/uuid" }, "deathBenefit": { "$ref": "urn:financia:schema:common#/$defs/yen" } }
                }
              }
            }
          }
        }
      }
    },
    "childScholarships": {
      "description": "子が返す貸与の奨学金（0104）: 返済は世帯のお金の動き・負債の残高に入れない。教育の目標の物・子・借りた総額・最初の月の返済額・返す期間（表の期間の中の最初と最後の月）・表の期間の中の返済の合計。持っていなければ欄が無い",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object", "member", "principal", "monthly", "from", "to", "total"],
        "properties": {
          "object": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
          "member": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
          "principal": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
          "monthly": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
          "from": { "$ref": "urn:financia:schema:common#/$defs/yearMonth" },
          "to": { "$ref": "urn:financia:schema:common#/$defs/yearMonth" },
          "total": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" }
        }
      }
    },
    "outsideWallets": {
      "description": "世帯の外の家族のお金（0042）: お金（member.wallet）を入れた人ごとの、お金が尽きる見込みの月（その月の生活費・税・社会保険料・介護の費用を払いきれなくなる最初の月。尽きなければ null）。尽きた後の介護の費用は世帯が払う",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["member", "depleted"],
        "properties": {
          "member": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
          "depleted": { "oneOf": [{ "type": "null" }, { "$ref": "urn:financia:schema:common#/$defs/yearMonth" }] }
        }
      }
    },
    "gifts": {
      "description": "贈与と贈与税（受け取る構成員×年）。inCashflow は世帯が受け取った贈与の税をキャッシュフロー表に載せたか（世帯から出す贈与の税は受け取る人が払うので載せない）",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["year", "recipient", "amount", "exempt", "tax", "inCashflow"],
        "properties": {
          "year": { "$ref": "urn:financia:schema:common#/$defs/year" },
          "recipient": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
          "amount": { "$ref": "urn:financia:schema:common#/$defs/yen" },
          "exempt": { "$ref": "urn:financia:schema:common#/$defs/yen" },
          "calendarTaxable": { "$ref": "urn:financia:schema:common#/$defs/yen" },
          "settlementTaxable": { "$ref": "urn:financia:schema:common#/$defs/yen" },
          "tax": { "$ref": "urn:financia:schema:common#/$defs/yen" },
          "inCashflow": { "type": "boolean" }
        }
      }
    },
    "error": {
      "description": "0005 の8: ID だけを入れ、値は入れない",
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "ids"],
          "properties": {
            "code": { "type": "string", "pattern": "^E_[A-Z_]+$" },
            "ids": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["header", "flows", "annual", "table", "summary", "trace"],
      "properties": {
        "protection": { "$ref": "#/$defs/protection" },
        "inheritanceTax": { "$ref": "#/$defs/inheritanceTax" },
        "header": { "$ref": "#/$defs/header" },
        "flows": { "type": "array", "items": { "$ref": "urn:financia:schema:common#/$defs/flow" } },
        "annual": { "type": "array", "items": { "$ref": "urn:financia:schema:common#/$defs/annualRow" } },
        "table": {
          "description": "キャッシュフロー表（行×年）。お金の動きは calcConventions.aggregation で年に集める",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["row", "year", "amount"],
            "properties": {
              "row": { "$ref": "urn:financia:schema:common#/$defs/rowId" },
              "year": { "$ref": "urn:financia:schema:common#/$defs/year" },
              "amount": { "$ref": "urn:financia:schema:common#/$defs/yen" },
              "member": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
              "object": { "$ref": "urn:financia:schema:common#/$defs/uuid" }
            }
          }
        },
        "summary": { "$ref": "#/$defs/summary" },
        "trace": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/traceSummary" }, { "$ref": "#/$defs/traceFull" }]
        }
      }
    },
    "componentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contract", "revision", "hash", "origin"],
      "properties": {
        "id": { "$ref": "urn:financia:schema:common#/$defs/dottedId" },
        "contract": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "revision": { "type": "integer", "minimum": 1 },
        "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "origin": { "enum": ["official", "replacement", "extension"] },
        "slot": { "$ref": "urn:financia:schema:common#/$defs/dottedId" }
      }
    },
    "header": {
      "description": "どの細かさでも必ず付ける見出し",
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "trace", "baseMonth", "endYear", "calcConventions", "components", "data", "notices"],
      "properties": {
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "sourceDigest"],
          "properties": {
            "version": { "type": "string" },
            "sourceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        },
        "trace": { "enum": ["none", "summary", "full"] },
        "baseMonth": { "$ref": "urn:financia:schema:common#/$defs/yearMonth" },
        "endYear": { "$ref": "urn:financia:schema:common#/$defs/year" },
        "calcConventions": { "$ref": "urn:financia:schema:engine.input#/properties/calcConventions" },
        "contingency": {
          "description": "重ねた万一の想定（0008 の5。月は解決した年月）",
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "member", "occurs"],
          "properties": {
            "id": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
            "kind": { "enum": ["death", "disability", "incapacity"] },
            "member": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
            "occurs": { "$ref": "urn:financia:schema:common#/$defs/yearMonth" },
            "grade": { "enum": [1, 2, 3] },
            "recovery": { "$ref": "urn:financia:schema:common#/$defs/yearMonth" }
          }
        },
        "stressTest": {
          "description": "展開したストレステストの型と値",
          "type": "object",
          "additionalProperties": false,
          "required": ["template", "params"],
          "properties": {
            "template": { "enum": ["marketDropAtRetirement", "inflationSpike", "rateRise", "incomeDrop", "lowReturnPeriod", "returnShortfall"] },
            "params": { "type": "object" }
          }
        },
        "components": { "type": "array", "items": { "$ref": "#/$defs/componentRef" } },
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["packId", "formatVersion", "version", "asOf", "digest", "fictional"],
            "properties": {
              "packId": { "type": "string" },
              "formatVersion": { "type": "string" },
              "version": { "type": "string" },
              "asOf": { "type": "string" },
              "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "fictional": { "type": "boolean" },
              "fictionalOf": { "type": "string" }
            }
          }
        },
        "notices": {
          "description": "計算に反映していないこと（未対応の制度など）。0005 の8 と同じく ID だけ",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "ids"],
            "properties": {
              "code": { "type": "string", "pattern": "^N_[A-Z_]+$" },
              "ids": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "paramUse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ref", "value", "packVersion"],
      "properties": {
        "id": { "$ref": "urn:financia:schema:common#/$defs/dottedId" },
        "ref": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9.]*@[0-9]+$" },
        "value": true,
        "packVersion": { "type": "string" },
        "extended": { "description": "延長の仮定で使った（0007 の追記）", "const": true },
        "backfilled": { "description": "さかのぼりの仮定で使った（制度データが持っている時期より前の日に最初の行の値。0099）", "const": true }
      }
    },
    "traceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "components", "timepoints"],
      "properties": {
        "mode": { "const": "summary" },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "formulas", "params", "roundings"],
            "properties": {
              "id": { "$ref": "urn:financia:schema:common#/$defs/dottedId" },
              "formulas": { "type": "array", "items": { "$ref": "urn:financia:schema:common#/$defs/dottedId" } },
              "params": { "type": "array", "items": { "$ref": "#/$defs/paramUse" } },
              "roundings": { "type": "array", "items": { "$ref": "urn:financia:schema:common#/$defs/dottedId" } }
            }
          }
        },
        "timepoints": { "type": "array", "items": { "$ref": "#/$defs/timepointNode" } }
      }
    },
    "timepointNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "timepoint", "ym"],
      "properties": {
        "type": { "const": "timepoint" },
        "event": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
        "timepoint": { "$ref": "urn:financia:schema:common#/$defs/timepoint" },
        "ym": { "$ref": "urn:financia:schema:common#/$defs/yearMonth" },
        "rule": { "$ref": "urn:financia:schema:common#/$defs/ageSwitch" }
      }
    },
    "traceFull": {
      "description": "重複を除いた記録（nodes）を、お金の動きから番号で指す有向グラフ",
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "nodes", "flows", "annual"],
      "properties": {
        "mode": { "const": "full" },
        "nodes": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "id", "ref", "value", "packVersion", "appliesFrom", "appliesTo", "sources"],
                "properties": {
                  "type": { "const": "param" },
                  "id": { "$ref": "urn:financia:schema:common#/$defs/dottedId" },
                  "ref": { "type": "string" },
                  "value": true,
                  "packVersion": { "type": "string" },
                  "appliesFrom": { "type": "string" },
                  "appliesTo": { "type": ["string", "null"] },
                  "sources": { "type": "array" },
                  "extended": { "const": true },
                  "backfilled": { "const": true }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "value"],
                "oneOf": [{ "required": ["item"] }, { "required": ["collection"] }],
                "properties": {
                  "type": { "const": "input" },
                  "item": { "$ref": "urn:financia:schema:common#/$defs/dottedId" },
                  "collection": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
                  "object": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
                  "value": true
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "rule", "op", "input", "result"],
                "properties": {
                  "type": { "const": "rounding" },
                  "rule": { "$ref": "urn:financia:schema:common#/$defs/dottedId" },
                  "op": { "enum": ["mulRate", "mulRatio", "divInt", "round", "allocate", "convert"] },
                  "input": { "type": "string" },
                  "result": true
                }
              },
              { "$ref": "#/$defs/timepointNode" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "component", "uses"],
                "properties": {
                  "type": { "const": "call" },
                  "component": { "$ref": "urn:financia:schema:common#/$defs/dottedId" },
                  "uses": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
                }
              }
            ]
          }
        },
        "flows": { "description": "出力のお金の動きと同じ順の、call の記録の番号", "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "annual": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
      }
    }
  }
}
