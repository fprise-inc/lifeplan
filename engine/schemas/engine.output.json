{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:financia:schema:engine.output",
  "title": "エンジン全体の出力（値＋根拠の記録。0006 の7）",
  "oneOf": [{ "$ref": "#/$defs/result" }, { "$ref": "#/$defs/error" }],
  "$defs": {
    "summary": {
      "description": "表から作る要約（0008 の追記）: 表の期間の合計（案どうしの比較）と、FP顧問料の年ごとの額・累計・契約ごとの合計（契約は物の ID。顧問料を除いた場合との差は enabled: false の要求と比べて出す）",
      "type": "object",
      "additionalProperties": false,
      "required": ["totals"],
      "properties": {
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["income", "taxSi", "expense", "net"],
          "properties": {
            "income": { "$ref": "urn:financia:schema:common#/$defs/yen" },
            "taxSi": { "$ref": "urn:financia:schema:common#/$defs/yen" },
            "expense": { "$ref": "urn:financia:schema:common#/$defs/yen" },
            "net": { "$ref": "urn:financia:schema:common#/$defs/yen" }
          }
        },
        "insurance": { "$ref": "#/$defs/insurance" },
        "gifts": { "$ref": "#/$defs/gifts" },
        "advisoryFee": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "byYear", "contracts"],
          "properties": {
            "total": { "$ref": "urn:financia:schema:common#/$defs/yen" },
            "byYear": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["year", "amount", "cumulative"],
                "properties": { "year": { "$ref": "urn:financia:schema:common#/$defs/year" }, "amount": { "$ref": "urn:financia:schema:common#/$defs/yen" }, "cumulative": { "$ref": "urn:financia:schema:common#/$defs/yen" } }
              }
            },
            "contracts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["total"],
                "properties": { "object": { "$ref": "urn:financia:schema:common#/$defs/uuid" }, "member": { "$ref": "urn:financia:schema:common#/$defs/uuid" }, "total": { "$ref": "urn:financia:schema:common#/$defs/yen" } }
              }
            }
          }
        }
      }
    },
    "protection": {
      "description": "6.3: 必要保障額の推移（構成員ごとに「この年に亡くなったら」を1年ずつずらす）。積み上げ方式は金融資産を含む額と含まない額、逆算方式は資産が尽きない最小の保険金。加入中の死亡保険金と並べる",
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "members"],
      "properties": {
        "method": { "enum": ["accumulation", "reverse"] },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["member", "years"],
            "properties": {
              "member": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
              "survivor": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
              "years": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["year", "death", "horizon", "need", "needWithAssets", "coverage"],
                  "properties": {
                    "year": { "$ref": "urn:financia:schema:common#/$defs/year" },
                    "death": { "$ref": "urn:financia:schema:common#/$defs/yearMonth" },
                    "horizon": { "$ref": "urn:financia:schema:common#/$defs/year" },
                    "need": { "description": "必要保障額（金融資産を含まない。積み上げ方式は不足額の累計、逆算方式は最小の保険金）", "$ref": "urn:financia:schema:common#/$defs/yen" },
                    "needWithAssets": { "description": "金融資産（亡くなった年の前の年末）を準備できる資金に含めた額", "$ref": "urn:financia:schema:common#/$defs/yen" },
                    "coverage": { "description": "加入中の死亡保険金（一時金と収入保障の残りの合計）", "$ref": "urn:financia:schema:common#/$defs/yen" },
                    "expenses": { "$ref": "urn:financia:schema:common#/$defs/yen" },
                    "resources": { "$ref": "urn:financia:schema:common#/$defs/yen" },
                    "lumpSum": { "$ref": "urn:financia:schema:common#/$defs/yen" },
                    "assets": { "$ref": "urn:financia:schema:common#/$defs/yen" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "insurance": {
      "description": "6.8: 保障内容一覧と払込保険料の推移の材料（商品を特定しない形）",
      "type": "object",
      "additionalProperties": false,
      "required": ["contracts", "byYear"],
      "properties": {
        "contracts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["object", "template", "policyholder", "insured", "coverages"],
            "properties": {
              "object": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
              "template": { "type": "string" },
              "policyholder": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
              "insured": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
              "coverages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "role", "benefit", "amount"],
                  "properties": {
                    "id": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
                    "role": { "enum": ["main", "rider"] },
                    "benefit": { "type": "string" },
                    "amount": { "$ref": "urn:financia:schema:common#/$defs/yen" },
                    "from": { "$ref": "urn:financia:schema:common#/$defs/yearMonth" },
                    "to": { "$ref": "urn:financia:schema:common#/$defs/yearMonth" }
                  }
                }
              }
            }
          }
        },
        "byYear": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["year", "object", "premium", "deathBenefit", "surrenderValue"],
            "properties": {
              "year": { "$ref": "urn:financia:schema:common#/$defs/year" },
              "object": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
              "premium": { "$ref": "urn:financia:schema:common#/$defs/yen" },
              "deathBenefit": { "$ref": "urn:financia:schema:common#/$defs/yen" },
              "surrenderValue": { "$ref": "urn:financia:schema:common#/$defs/yen" }
            }
          }
        }
      }
    },
    "gifts": {
      "description": "贈与と贈与税（受け取る構成員×年）。inCashflow は世帯が受け取った贈与の税をキャッシュフロー表に載せたか（世帯から出す贈与の税は受け取る人が払うので載せない）",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["year", "recipient", "amount", "exempt", "tax", "inCashflow"],
        "properties": {
          "year": { "$ref": "urn:financia:schema:common#/$defs/year" },
          "recipient": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
          "amount": { "$ref": "urn:financia:schema:common#/$defs/yen" },
          "exempt": { "$ref": "urn:financia:schema:common#/$defs/yen" },
          "calendarTaxable": { "$ref": "urn:financia:schema:common#/$defs/yen" },
          "settlementTaxable": { "$ref": "urn:financia:schema:common#/$defs/yen" },
          "tax": { "$ref": "urn:financia:schema:common#/$defs/yen" },
          "inCashflow": { "type": "boolean" }
        }
      }
    },
    "error": {
      "description": "0005 の8: ID だけを入れ、値は入れない",
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "ids"],
          "properties": {
            "code": { "type": "string", "pattern": "^E_[A-Z_]+$" },
            "ids": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["header", "flows", "annual", "table", "summary", "trace"],
      "properties": {
        "protection": { "$ref": "#/$defs/protection" },
        "header": { "$ref": "#/$defs/header" },
        "flows": { "type": "array", "items": { "$ref": "urn:financia:schema:common#/$defs/flow" } },
        "annual": { "type": "array", "items": { "$ref": "urn:financia:schema:common#/$defs/annualRow" } },
        "table": {
          "description": "キャッシュフロー表（行×年）。お金の動きは calcConventions.aggregation で年に集める",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["row", "year", "amount"],
            "properties": {
              "row": { "$ref": "urn:financia:schema:common#/$defs/rowId" },
              "year": { "$ref": "urn:financia:schema:common#/$defs/year" },
              "amount": { "$ref": "urn:financia:schema:common#/$defs/yen" },
              "member": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
              "object": { "$ref": "urn:financia:schema:common#/$defs/uuid" }
            }
          }
        },
        "summary": { "$ref": "#/$defs/summary" },
        "trace": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/traceSummary" }, { "$ref": "#/$defs/traceFull" }]
        }
      }
    },
    "componentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contract", "revision", "hash", "origin"],
      "properties": {
        "id": { "$ref": "urn:financia:schema:common#/$defs/dottedId" },
        "contract": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "revision": { "type": "integer", "minimum": 1 },
        "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "origin": { "enum": ["official", "replacement", "extension"] },
        "slot": { "$ref": "urn:financia:schema:common#/$defs/dottedId" }
      }
    },
    "header": {
      "description": "どの細かさでも必ず付ける見出し",
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "trace", "baseMonth", "endYear", "calcConventions", "components", "data", "notices"],
      "properties": {
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "sourceDigest"],
          "properties": {
            "version": { "type": "string" },
            "sourceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        },
        "trace": { "enum": ["none", "summary", "full"] },
        "baseMonth": { "$ref": "urn:financia:schema:common#/$defs/yearMonth" },
        "endYear": { "$ref": "urn:financia:schema:common#/$defs/year" },
        "calcConventions": { "$ref": "urn:financia:schema:engine.input#/properties/calcConventions" },
        "contingency": {
          "description": "重ねた万一の想定（0008 の5。月は解決した年月）",
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "member", "occurs"],
          "properties": {
            "id": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
            "kind": { "enum": ["death", "disability", "incapacity"] },
            "member": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
            "occurs": { "$ref": "urn:financia:schema:common#/$defs/yearMonth" },
            "grade": { "enum": [1, 2, 3] },
            "recovery": { "$ref": "urn:financia:schema:common#/$defs/yearMonth" }
          }
        },
        "stressTest": {
          "description": "展開したストレステストの型と値",
          "type": "object",
          "additionalProperties": false,
          "required": ["template", "params"],
          "properties": {
            "template": { "enum": ["marketDropAtRetirement", "inflationSpike", "rateRise", "incomeDrop"] },
            "params": { "type": "object" }
          }
        },
        "components": { "type": "array", "items": { "$ref": "#/$defs/componentRef" } },
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["packId", "formatVersion", "version", "asOf", "digest", "fictional"],
            "properties": {
              "packId": { "type": "string" },
              "formatVersion": { "type": "string" },
              "version": { "type": "string" },
              "asOf": { "type": "string" },
              "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "fictional": { "type": "boolean" },
              "fictionalOf": { "type": "string" }
            }
          }
        },
        "notices": {
          "description": "計算に反映していないこと（未対応の制度など）。0005 の8 と同じく ID だけ",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "ids"],
            "properties": {
              "code": { "type": "string", "pattern": "^N_[A-Z_]+$" },
              "ids": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "paramUse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ref", "value", "packVersion"],
      "properties": {
        "id": { "$ref": "urn:financia:schema:common#/$defs/dottedId" },
        "ref": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9.]*@[0-9]+$" },
        "value": true,
        "packVersion": { "type": "string" },
        "extended": { "description": "延長の仮定で使った（0007 の追記）", "const": true }
      }
    },
    "traceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "components", "timepoints"],
      "properties": {
        "mode": { "const": "summary" },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "formulas", "params", "roundings"],
            "properties": {
              "id": { "$ref": "urn:financia:schema:common#/$defs/dottedId" },
              "formulas": { "type": "array", "items": { "$ref": "urn:financia:schema:common#/$defs/dottedId" } },
              "params": { "type": "array", "items": { "$ref": "#/$defs/paramUse" } },
              "roundings": { "type": "array", "items": { "$ref": "urn:financia:schema:common#/$defs/dottedId" } }
            }
          }
        },
        "timepoints": { "type": "array", "items": { "$ref": "#/$defs/timepointNode" } }
      }
    },
    "timepointNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "timepoint", "ym"],
      "properties": {
        "type": { "const": "timepoint" },
        "event": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
        "timepoint": { "$ref": "urn:financia:schema:common#/$defs/timepoint" },
        "ym": { "$ref": "urn:financia:schema:common#/$defs/yearMonth" },
        "rule": { "$ref": "urn:financia:schema:common#/$defs/ageSwitch" }
      }
    },
    "traceFull": {
      "description": "重複を除いた記録（nodes）を、お金の動きから番号で指す有向グラフ",
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "nodes", "flows", "annual"],
      "properties": {
        "mode": { "const": "full" },
        "nodes": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "id", "ref", "value", "packVersion", "appliesFrom", "appliesTo", "sources"],
                "properties": {
                  "type": { "const": "param" },
                  "id": { "$ref": "urn:financia:schema:common#/$defs/dottedId" },
                  "ref": { "type": "string" },
                  "value": true,
                  "packVersion": { "type": "string" },
                  "appliesFrom": { "type": "string" },
                  "appliesTo": { "type": ["string", "null"] },
                  "sources": { "type": "array" },
                  "extended": { "const": true }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "value"],
                "oneOf": [{ "required": ["item"] }, { "required": ["collection"] }],
                "properties": {
                  "type": { "const": "input" },
                  "item": { "$ref": "urn:financia:schema:common#/$defs/dottedId" },
                  "collection": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
                  "object": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
                  "value": true
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "rule", "op", "input", "result"],
                "properties": {
                  "type": { "const": "rounding" },
                  "rule": { "$ref": "urn:financia:schema:common#/$defs/dottedId" },
                  "op": { "enum": ["mulRate", "mulRatio", "divInt", "round", "allocate", "convert"] },
                  "input": { "type": "string" },
                  "result": true
                }
              },
              { "$ref": "#/$defs/timepointNode" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "component", "uses"],
                "properties": {
                  "type": { "const": "call" },
                  "component": { "$ref": "urn:financia:schema:common#/$defs/dottedId" },
                  "uses": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
                }
              }
            ]
          }
        },
        "flows": { "description": "出力のお金の動きと同じ順の、call の記録の番号", "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "annual": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
      }
    }
  }
}
