{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:financia:schema:component:housing.residence.output",
  "title": "住まいのお金の動きと購入した持ち家（と地震保険料の支払い）",
  "type": "object",
  "additionalProperties": false,
  "required": ["flows", "properties"],
  "properties": {
    "flows": { "type": "array", "items": { "$ref": "urn:financia:schema:common#/$defs/flow" } },
    "properties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object", "owner", "from", "to", "price"],
        "properties": {
          "object": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
          "owner": { "oneOf": [{ "type": "null" }, { "$ref": "urn:financia:schema:common#/$defs/uuid" }] },
          "from": { "$ref": "urn:financia:schema:common#/$defs/yearMonth" },
          "to": { "oneOf": [{ "type": "null" }, { "$ref": "urn:financia:schema:common#/$defs/yearMonth" }] },
          "price": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" }
        }
      }
    },
    "earthquakePremiums": {
      "description": "0221: 住宅購入の予定の地震保険料の支払い（払った人・月・years 年分の額・年数。計算基準月より前の支払いも含む）。地震保険料控除の元",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["member", "ym", "amount", "years"],
        "properties": {
          "member": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
          "ym": { "$ref": "urn:financia:schema:common#/$defs/yearMonth" },
          "amount": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
          "years": { "type": "integer", "minimum": 1, "maximum": 5 }
        }
      }
    }
  }
}
