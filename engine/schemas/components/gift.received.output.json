{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:financia:schema:component:gift.received.output",
  "title": "受け取る贈与",
  "type": "object",
  "additionalProperties": false,
  "required": ["gifts"],
  "properties": {
    "gifts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ym", "source", "object", "amount", "giver", "giverMember", "method", "housing", "inflow"],
        "properties": {
          "ym": { "$ref": "urn:financia:schema:common#/$defs/yearMonth" },
          "source": { "description": "約束の版 1.2（0044）: incomeFlow（入るお金の行の贈与税で見る行）・periodicExpense（あげる贈与）", "enum": ["housingPurchase", "education", "insurance", "incomeFlow", "periodicExpense"] },
          "object": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
          "amount": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
          "giver": { "enum": ["parent", "grandparent", "household", "other"] },
          "giverMember": { "oneOf": [{ "type": "null" }, { "$ref": "urn:financia:schema:common#/$defs/uuid" }] },
          "donor": { "description": "約束の版 1.1: 世帯の外の贈与者（donors の ID）。同じ贈与者からの贈与を合わせて数える", "$ref": "urn:financia:schema:common#/$defs/uuid" },
          "method": { "enum": ["calendar", "settlement"] },
          "housing": { "enum": [null, "energySaving", "other"] },
          "inflow": { "type": "boolean" }
        }
      }
    }
  }
}
