{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:financia:schema:component:plan.cashflow.output",
  "title": "キャッシュフロー表の部品の出力",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "flows",
    "annual"
  ],
  "properties": {
    "flows": {
      "type": "array",
      "items": {
        "$ref": "urn:financia:schema:common#/$defs/flow"
      }
    },
    "annual": {
      "type": "array",
      "items": {
        "$ref": "urn:financia:schema:common#/$defs/annualRow"
      }
    },
    "parts": {
      "description": "flows を、出した部品の出力ごとの配列に分けたもの（任意。つなげると flows と同じ中身）。エンジンが表の集計を部品ごとに使い回すため（0005 の追記）",
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "$ref": "urn:financia:schema:common#/$defs/flow"
        }
      }
    },
    "details": {
      "description": "約束の版 1.2: 保障内容一覧・払込保険料の推移の材料（insurance）と贈与の税（gifts）。約束の版 1.4: 世帯の外の家族のお金が尽きる見込みの月（outsideWallets。0042）。約束の版 1.6: 住まい以外の不動産の物件ごとの数字（realEstate）。約束の版 1.7: 収益不動産の分析の数字（realEstateAnalysis。0082）。エンジンが出力の summary に写す（任意の欄）",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "insurance": {
          "$ref": "urn:financia:schema:engine.output#/$defs/insurance"
        },
        "gifts": {
          "$ref": "urn:financia:schema:engine.output#/$defs/gifts"
        },
        "outsideWallets": {
          "$ref": "urn:financia:schema:engine.output#/$defs/outsideWallets"
        },
        "realEstate": {
          "description": "約束の版 1.6: 住まい以外の不動産の物件ごとの数字（asset.realEstate の出力の properties のまま。0009 の追記）",
          "$ref": "urn:financia:schema:component:asset.realEstate.output#/properties/properties"
        },
        "realEstateAnalysis": {
          "description": "約束の版 1.7: 収益不動産の分析の数字（asset.realEstateAnalysis の出力のまま。0082）",
          "$ref": "urn:financia:schema:component:asset.realEstateAnalysis.output"
        }
      }
    }
  }
}
