{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:financia:schema:component:pension.disability.output",
  "title": "障害年金の部品の出力",
  "type": "object",
  "additionalProperties": false,
  "required": ["flows", "months"],
  "properties": {
    "flows": { "type": "array", "items": { "$ref": "urn:financia:schema:common#/$defs/flow" } },
    "months": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["month", "basic", "employee"],
        "properties": {
          "month": { "$ref": "urn:financia:schema:common#/$defs/yearMonth" },
          "basic": { "$ref": "urn:financia:schema:common#/$defs/yen" },
          "employee": { "$ref": "urn:financia:schema:common#/$defs/yen" }
        }
      }
    },
    "choices": {
      "description": "約束の版 1.1: 65歳からの組み合わせ（手取りが多いもの）。月の範囲（両端を含む）",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "combination"],
        "properties": {
          "from": { "$ref": "urn:financia:schema:common#/$defs/yearMonth" },
          "to": { "$ref": "urn:financia:schema:common#/$defs/yearMonth" },
          "combination": { "enum": ["disability", "oldAge", "disabilityBasicOldAgeEmployee"] }
        }
      }
    }
  }
}
