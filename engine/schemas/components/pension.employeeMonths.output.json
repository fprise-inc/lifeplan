{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:financia:schema:component:pension.employeeMonths.output",
  "title": "厚生年金の被保険者期間の月数と、厚生年金240月以上の老齢厚生年金の受給権を持つ最初の月（約束の版 1.1。無ければ null）",
  "type": "object",
  "additionalProperties": false,
  "required": ["months"],
  "properties": {
    "months": { "type": "integer", "minimum": 0 },
    "longFrom": { "oneOf": [{ "$ref": "urn:financia:schema:common#/$defs/yearMonth" }, { "type": "null" }] }
  }
}
