{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:financia:schema:component:incomeTax.annual.output",
  "title": "所得税の年税額と途中の値",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "flows",
    "total",
    "taxable",
    "computedTax",
    "reconstructionSurtax",
    "defenseSurtax"
  ],
  "properties": {
    "flows": {
      "type": "array",
      "items": {
        "$ref": "urn:financia:schema:common#/$defs/flow"
      }
    },
    "total": {
      "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen"
    },
    "taxable": {
      "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen"
    },
    "computedTax": {
      "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen"
    },
    "reconstructionSurtax": {
      "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen"
    },
    "defenseSurtax": {
      "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen"
    },
    "housingLoanCredit": {
      "description": "引いた住宅借入金等特別控除（約束の版 1.1。任意）",
      "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen"
    },
    "creditRemainder": {
      "description": "所得税から引ききれなかった住宅借入金等特別控除（1.1。任意）",
      "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen"
    }
  }
}
