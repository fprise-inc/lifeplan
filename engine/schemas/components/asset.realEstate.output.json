{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:financia:schema:component:asset.realEstate.output",
  "title": "住まい以外の不動産の評価額（土地・建物）・家賃収入・経費・不動産所得・売却",
  "type": "object",
  "additionalProperties": false,
  "required": ["flows", "properties"],
  "properties": {
    "flows": { "type": "array", "items": { "$ref": "urn:financia:schema:common#/$defs/flow" } },
    "properties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object", "owner", "years", "income", "sale"],
        "properties": {
          "object": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
          "owner": { "$ref": "urn:financia:schema:common#/$defs/uuid" },
          "years": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["year", "land", "building", "value"],
              "properties": {
                "year": { "$ref": "urn:financia:schema:common#/$defs/year" },
                "land": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                "building": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                "value": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                "book": { "description": "1.3: 年末の帳簿価額（取得価額＋取得時の諸費用−その年の年末までの建物と建物附属設備の減価償却の累計。取得の入力があるときだけ）", "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" }
              }
            }
          },
          "income": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["year", "rent", "expenses", "depreciation", "interest", "landInterest", "income"],
              "properties": {
                "year": { "$ref": "urn:financia:schema:common#/$defs/year" },
                "rent": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                "expenses": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                "depreciation": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                "interest": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                "landInterest": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                "income": { "$ref": "urn:financia:schema:common#/$defs/yen" }
              }
            }
          },
          "sale": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["ym", "value", "price", "costs", "proceeds"],
                "properties": {
                  "ym": { "$ref": "urn:financia:schema:common#/$defs/yearMonth" },
                  "value": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                  "price": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                  "costs": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                  "proceeds": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                  "acquisitionCost": { "description": "取得費（1.1。取得価額＋取得時の諸費用−建物と建物附属設備の償却の累計、または概算取得費。0081）", "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                  "estimated": { "description": "概算取得費（売却価格の5%）を使ったか（1.1）", "type": "boolean" },
                  "gain": { "description": "譲渡所得（売却価格−取得費−売却の費用。マイナスは損失。1.1）", "$ref": "urn:financia:schema:common#/$defs/yen" },
                  "term": { "description": "長期（売った年の1月1日の所有期間が5年を超える）・短期（1.1）", "enum": ["long", "short"] }
                }
              }
            ]
          },
          "incomeKind": { "description": "所得の区分（1.1。民泊・宿の雑所得 miscellaneous・事業所得 business。無ければ不動産所得。0081）", "enum": ["miscellaneous", "business"] },
          "units": {
            "description": "事業的規模の目安に数える室数・棟数（1.1。不動産所得の物件。0081）",
            "type": "object",
            "additionalProperties": false,
            "required": ["rooms", "houses"],
            "properties": {
              "rooms": { "type": "integer", "minimum": 0 },
              "houses": { "type": "integer", "minimum": 0 }
            }
          },
          "cash": {
            "description": "分析の数字の材料（1.2。0082）: 計算基準年から、持っている月が表にある年ごと。表に載る月（計算基準月から）の分の貸している月数・満室のときの収入（空室を見込む前。礼金・更新料は入れない。民泊・宿は稼働率100%の売上、月の売上で入れたときは null）・受け取った収入・経費（大きな修繕を除く）・大きな修繕",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["year", "months", "gross", "rent", "expenses", "repairs"],
              "properties": {
                "year": { "$ref": "urn:financia:schema:common#/$defs/year" },
                "months": { "type": "integer", "minimum": 0, "maximum": 12 },
                "gross": { "oneOf": [{ "type": "null" }, { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" }] },
                "rent": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                "expenses": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                "repairs": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" }
              }
            }
          },
          "facts": {
            "description": "物件の事実（1.2。0082）: 取得価額の合計・取得時の諸費用・自己資金、建った年、法定耐用年数、減価償却が終わる年（建物・建物附属設備。無ければ null）、民泊・宿の1泊の単価・稼働率・営業日数。1.3: 売る・貸し終わるまでに償却が終わらないときの、貸し続けたら終わる年（depreciationEndIfContinued）と、建物の分が無い物件の印（noBuilding）",
            "type": "object",
            "additionalProperties": false,
            "required": ["acquisition", "builtYear", "legalLife", "depreciationEnd"],
            "properties": {
              "acquisition": {
                "oneOf": [
                  { "type": "null" },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["total", "costs"],
                    "properties": {
                      "total": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                      "costs": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                      "equity": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" }
                    }
                  }
                ]
              },
              "builtYear": { "$ref": "urn:financia:schema:common#/$defs/year" },
              "legalLife": { "type": "integer", "minimum": 1 },
              "depreciationEnd": {
                "type": "object",
                "additionalProperties": false,
                "required": ["building", "equipment"],
                "properties": {
                  "building": { "oneOf": [{ "type": "null" }, { "type": "integer" }] },
                  "equipment": { "oneOf": [{ "type": "null" }, { "type": "integer" }] }
                }
              },
              "depreciationEndIfContinued": {
                "type": "object",
                "additionalProperties": false,
                "required": ["building", "equipment"],
                "properties": {
                  "building": { "oneOf": [{ "type": "null" }, { "type": "integer" }] },
                  "equipment": { "oneOf": [{ "type": "null" }, { "type": "integer" }] }
                }
              },
              "noBuilding": { "const": true },
              "lodging": {
                "type": "object",
                "additionalProperties": false,
                "required": ["nightly", "occupancy", "days"],
                "properties": {
                  "nightly": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
                  "occupancy": { "$ref": "urn:financia:schema:common#/$defs/rate" },
                  "days": { "type": "integer", "minimum": 0, "maximum": 366 }
                }
              }
            }
          }
        }
      }
    }
  }
}
