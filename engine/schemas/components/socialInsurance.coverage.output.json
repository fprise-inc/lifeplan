{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:financia:schema:component:socialInsurance.coverage.output",
  "title": "socialInsurance.coverage の出力",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "months",
    "bonuses",
    "wages"
  ],
  "properties": {
    "months": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "month",
          "paidIn",
          "period",
          "healthStd",
          "pensionStd",
          "care"
        ],
        "properties": {
          "month": {
            "$ref": "urn:financia:schema:common#/$defs/yearMonth"
          },
          "paidIn": {
            "$ref": "urn:financia:schema:common#/$defs/yearMonth"
          },
          "period": {
            "$ref": "urn:financia:schema:common#/$defs/uuid"
          },
          "healthStd": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen"
              }
            ]
          },
          "pensionStd": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen"
              }
            ]
          },
          "care": {
            "type": "boolean"
          },
          "exempt": {
            "type": "boolean"
          },
          "workingStd": {
            "description": "70歳以上で適用事業所に使用される月の標準報酬月額に相当する額（1.2）",
            "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen"
          }
        }
      }
    },
    "bonuses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "month",
          "period",
          "healthStdBonus",
          "pensionStdBonus",
          "care"
        ],
        "properties": {
          "month": {
            "$ref": "urn:financia:schema:common#/$defs/yearMonth"
          },
          "period": {
            "$ref": "urn:financia:schema:common#/$defs/uuid"
          },
          "healthStdBonus": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen"
              }
            ]
          },
          "pensionStdBonus": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen"
              }
            ]
          },
          "care": {
            "type": "boolean"
          },
          "exempt": {
            "type": "boolean"
          },
          "workingStdBonus": {
            "description": "70歳以上の標準賞与額に相当する額（1.2）",
            "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen"
          }
        }
      }
    },
    "wages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "month",
          "period",
          "kind",
          "wage"
        ],
        "properties": {
          "month": {
            "$ref": "urn:financia:schema:common#/$defs/yearMonth"
          },
          "period": {
            "$ref": "urn:financia:schema:common#/$defs/uuid"
          },
          "kind": {
            "enum": [
              "salary",
              "bonus"
            ]
          },
          "wage": {
            "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen"
          }
        }
      }
    }
  }
}
