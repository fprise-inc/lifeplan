{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:financia:schema:component:debt.schedule.output",
  "title": "負債の返済",
  "type": "object",
  "additionalProperties": false,
  "required": ["flows", "yearEnd", "firstPayment", "payoff"],
  "properties": {
    "flows": { "type": "array", "items": { "$ref": "urn:financia:schema:common#/$defs/flow" } },
    "yearEnd": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["year", "balance", "unpaidInterest"],
        "properties": {
          "year": { "$ref": "urn:financia:schema:common#/$defs/year" },
          "balance": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
          "unpaidInterest": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" }
        }
      }
    },
    "firstPayment": { "$ref": "urn:financia:schema:common#/$defs/yearMonth" },
    "payoff": { "oneOf": [{ "type": "null" }, { "$ref": "urn:financia:schema:common#/$defs/yearMonth" }] },
    "interest": {
      "description": "年ごとの利息（計算基準月から。約束の版 1.2 の任意の欄。0028）",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["year", "amount"],
        "properties": { "year": { "$ref": "urn:financia:schema:common#/$defs/year" }, "amount": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" } }
      }
    },
    "refinances": {
      "description": "借り換えごとの、借り換えの直前の残高と新しいローンの借入額・期間（約束の版 1.3 の任意の欄。住宅ローン控除の借り換えの扱いに使う）",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ym", "before", "principal", "termMonths"],
        "properties": {
          "ym": { "$ref": "urn:financia:schema:common#/$defs/yearMonth" },
          "before": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
          "principal": { "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen" },
          "termMonths": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
