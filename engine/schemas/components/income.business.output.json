{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:financia:schema:component:income.business.output",
  "title": "income.business の出力",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "flows",
    "byYear"
  ],
  "properties": {
    "flows": {
      "type": "array",
      "items": {
        "$ref": "urn:financia:schema:common#/$defs/flow"
      }
    },
    "byYear": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "year",
          "income"
        ],
        "properties": {
          "year": {
            "$ref": "urn:financia:schema:common#/$defs/year"
          },
          "income": {
            "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen"
          }
        }
      }
    }
  }
}
