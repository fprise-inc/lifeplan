{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:financia:schema:component:pension.record.output",
  "title": "pension.record の出力",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "fiscalYear",
    "asOf",
    "basicMonths",
    "employeeMonths",
    "employee2059Months",
    "qualifyingMonths",
    "amounts",
    "months"
  ],
  "properties": {
    "kind": {
      "enum": [
        "statementUnder50",
        "statementOver50",
        "receiving",
        "history",
        "projection",
        "estimated"
      ]
    },
    "fiscalYear": {
      "$ref": "urn:financia:schema:common#/$defs/year"
    },
    "asOf": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "urn:financia:schema:common#/$defs/yearMonth"
        }
      ]
    },
    "basicMonths": {
      "type": "integer",
      "minimum": 0
    },
    "employeeMonths": {
      "type": "integer",
      "minimum": 0
    },
    "employee2059Months": {
      "type": "integer",
      "minimum": 0
    },
    "qualifyingMonths": {
      "type": "integer",
      "minimum": 0
    },
    "amounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basic",
        "employee",
        "transitional",
        "special"
      ],
      "properties": {
        "basic": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen"
            }
          ]
        },
        "employee": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen"
            }
          ]
        },
        "transitional": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen"
            }
          ]
        },
        "special": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen"
            }
          ]
        }
      }
    },
    "months": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "month",
          "basic",
          "employee",
          "employee2059",
          "remuneration",
          "accrues"
        ],
        "properties": {
          "month": {
            "$ref": "urn:financia:schema:common#/$defs/yearMonth"
          },
          "basic": {
            "type": "boolean"
          },
          "employee": {
            "type": "boolean"
          },
          "employee2059": {
            "type": "boolean"
          },
          "remuneration": {
            "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen"
          },
          "accrues": {
            "type": "boolean"
          }
        }
      }
    },
    "category1": {
      "description": "約束の版 1.1: 記録の第1号の期間の内訳（20〜59歳。記録の時点まで）。known は入力に内訳があったか（加入歴・定期便の category1）。pre2009 は2009年3月以前の免除の月数（種類ごと。老齢基礎年金の割合が違う。加入歴だけ）",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "known",
        "paid",
        "exemptQuarter",
        "exemptHalf",
        "exemptThreeQuarters",
        "exemptFull",
        "deferred",
        "pre2009"
      ],
      "properties": {
        "paid": {
          "type": "integer",
          "minimum": 0
        },
        "exemptQuarter": {
          "type": "integer",
          "minimum": 0
        },
        "exemptHalf": {
          "type": "integer",
          "minimum": 0
        },
        "exemptThreeQuarters": {
          "type": "integer",
          "minimum": 0
        },
        "exemptFull": {
          "type": "integer",
          "minimum": 0
        },
        "deferred": {
          "type": "integer",
          "minimum": 0
        },
        "known": {
          "type": "boolean"
        },
        "pre2009": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exemptQuarter",
            "exemptHalf",
            "exemptThreeQuarters",
            "exemptFull"
          ],
          "properties": {
            "exemptQuarter": {
              "type": "integer",
              "minimum": 0
            },
            "exemptHalf": {
              "type": "integer",
              "minimum": 0
            },
            "exemptThreeQuarters": {
              "type": "integer",
              "minimum": 0
            },
            "exemptFull": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "employeeFromMiddleAge": {
      "description": "約束の版 1.1: 加入歴の厚生年金の月のうち40歳（女子35歳）以後の月数（中高齢者の期間短縮の特例。記録の時点まで）",
      "type": "integer",
      "minimum": 0
    }
  }
}
