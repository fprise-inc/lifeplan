{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:financia:schema:component:tax.totalIncome.output",
  "title": "合計所得金額",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "total",
    "employment"
  ],
  "properties": {
    "total": {
      "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen"
    },
    "employment": {
      "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen"
    },
    "publicPension": {
      "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen"
    },
    "other": {
      "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen"
    },
    "adjustment": {
      "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen"
    },
    "retirement": {
      "description": "分離課税の退職所得の金額（1.2。total には入らない）",
      "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen"
    },
    "temporary": {
      "description": "保険の一時所得のうち総所得金額に入れた額（1.3。total に入る）",
      "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen"
    },
    "miscellaneous": {
      "description": "個人年金の雑所得（1.3。total に入る）",
      "$ref": "urn:financia:schema:common#/$defs/nonNegativeYen"
    },
    "realEstate": {
      "description": "不動産所得（1.4。マイナスは損失。損失は土地の取得のための借入の利息の分を除いて total に入る。0028）",
      "$ref": "urn:financia:schema:common#/$defs/yen"
    }
  }
}
